{
  outputs = { self }: {
    packages.x86_64-linux = {
      other = import ./other.nix;
    }
    // (
      if "@empty@" == "true" then
        { }
      else
        { "@name@" = import (./. + "/pkgs/by-name/@prefix@/@name@/package.nix"); }
    );
    applicationChecks.x86_64-linux =
      if "@application@" == "true" then
        {
          "@name@-cli" = null;
          "@name@-gui" = null;
          "@name@-wayland" = null;
          "@name@-licenses" = null;
          "@name@-appstream" = null;
          "@name@-wayland-clipboard" = null;
          "@name@-server" = null;
          "@name@-quit-state" = null;
          "@name@-host-tests-artifact" = null;
          "@name@-appimage-runtime" = null;
          other-cli = null;
        }
      else
        { };
  };
}
