{
  outputs =
    { self }:
    let
      check =
        suffix:
        builtins.derivation {
          name = "@name@-" + suffix;
          system = "x86_64-linux";
          builder = "/fixture-not-executed";
          package = import (./. + "/pkgs/by-name/@prefix@/@name@/package.nix");
          contractInput = builtins.readFile (./. + "/pkgs/by-name/@prefix@/@name@/contract-version");
        };
    in
    {
      packages.x86_64-linux = {
        other = import ./other.nix;
      }
      // (
        if "@empty@" == "true" then
          { }
        else
          { "@name@" = import (./. + "/pkgs/by-name/@prefix@/@name@/package.nix"); }
      );
      applicationChecks.x86_64-linux =
        if "@broken_application@" == "true" then
          throw "base application checks are unavailable"
        else if "@application@" == "true" then
          {
            "@name@-cli" = check "cli";
            "@name@-gui" = check "gui";
            "@name@-wayland" = check "wayland";
            "@name@-licenses" = check "licenses";
            "@name@-appstream" = check "appstream";
            "@name@-wayland-clipboard" = check "wayland-clipboard";
            "@name@-server" = check "server";
            "@name@-quit-state" = check "quit-state";
            "@name@-host-tests-artifact" = check "host-tests-artifact";
            "@name@-appimage-runtime" = check "appimage-runtime";
            other-cli = check "other-cli";
          }
        else
          { };
    };
}
