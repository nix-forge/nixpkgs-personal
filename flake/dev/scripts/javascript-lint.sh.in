# shellcheck shell=bash
set -euo pipefail
lint_directory=$(mktemp -d)
trap 'rm -rf "$lint_directory"' EXIT
cp .oxlintrc.json tsconfig.json package.json package-lock.json "$lint_directory/"
# Mirror sources beside pinned typings without installing into the checkout.
find tests pkgs/by-name \
  -type d \( -name node_modules -o -name dist -o -name build \) -prune -o \
  -type f \( -name '*.ts' -o -name '*.mts' -o -name '*.cts' -o -name '*.tsx' \
  -o -name '*.js' -o -name '*.mjs' -o -name '*.cjs' -o -name '*.jsx' -o -name '*.json' \) \
  -exec cp --parents --target-directory="$lint_directory" {} +
ln -s @javascript_tools@/lib/node_modules "$lint_directory/node_modules"
cd "$lint_directory"
@npm@ run typecheck
@npm@ run lint
# Lint maintained trees rather than the pinned dependency symlink.
@oxlint@ --config .oxlintrc.json --deny-warnings tests pkgs/by-name
