--- /dev/null
+++ b/src/node_rss.h
@@ -0,0 +1,29 @@
+// Node 24's RSS contract matches its bundled libuv's resident-size metric.
+// Shared libuv 1.53 uses physical footprint; keep that library API unchanged.
+#ifndef SRC_NODE_RSS_H_
+#define SRC_NODE_RSS_H_
+
+#include "uv.h"
+#ifdef __APPLE__
+#include <mach/mach.h>
+#endif
+
+namespace node {
+inline int GetResidentSetMemory(size_t* rss) {
+#ifdef __APPLE__
+  task_basic_info_data_t info;
+  mach_msg_type_number_t count = TASK_BASIC_INFO_COUNT;
+  kern_return_t error = task_info(mach_task_self(),
+                                  TASK_BASIC_INFO,
+                                  reinterpret_cast<task_info_t>(&info),
+                                  &count);
+  if (error != KERN_SUCCESS) return UV_EIO;
+  *rss = info.resident_size;
+  return 0;
+#else
+  return uv_resident_set_memory(rss);
+#endif
+}
+}  // namespace node
+
+#endif  // SRC_NODE_RSS_H_
