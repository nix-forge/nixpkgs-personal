+export const getResponsiveImageSource = (image) => {
+  const fallback = image?.getAttribute("src") || null
+  const candidates = parseSrcSetCandidates(image?.getAttribute("srcset") || "").filter(
+    ({ source }) => /^(?:https?:\/\/|\/(?!\/))/i.test(source),
+  )
+  if (!candidates.length) return fallback
+  const type = candidates[0].descriptor.type
+  if (candidates.some(({ descriptor }) => descriptor.type !== type)) return fallback
+  const target = type === "w" ? 1024 : 2
+  const sorted = candidates.toSorted((a, b) => a.descriptor.value - b.descriptor.value)
+  const bounded = sorted.findLast(({ descriptor }) => descriptor.value <= target)
+  // A sparse srcset may jump from a thumbnail straight to the article image.
+  // Prefer that supplied image over a visibly undersized cover.
+  return (
+    bounded && bounded.descriptor.value >= target / 2
+      ? bounded
+      : (sorted.find(({ descriptor }) => descriptor.value > target) ?? sorted.at(-1))
+  ).source
+}
