@@ -79,5 +84,21 @@
     async def classify(self, user_message: str) -> bool:
         if not user_message:
             return False
+        # A privacy request that says to preserve amounts is not asking for a
+        # math audit. Bypass the small model for this unambiguous case so it
+        # cannot route sensitive-document review to the wrong tool.
+        privacy_request = re.search(
+            r"\b(?:privacy|redact(?:ion|ed|ing)?|personally identifying)\b",
+            user_message,
+            re.IGNORECASE,
+        )
+        explicit_math_request = re.search(
+            r"\b(?:check|verify|audit|recalculate|validate)\b.{0,100}"
+            r"\b(?:math|arithmetic|calculations?|totals?|sums?|percentages?|balances?|figures?)\b",
+            user_message,
+            re.IGNORECASE | re.DOTALL,
+        )
+        if privacy_request and not explicit_math_request:
+            return False
         result = await self._agent.run(user_message)
         return result.output.is_math
