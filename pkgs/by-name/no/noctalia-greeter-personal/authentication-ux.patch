diff --git a/tests/power_confirmation_test.cpp b/tests/power_confirmation_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/power_confirmation_test.cpp
@@ -0,0 +1,20 @@
+#include "greeter/power_confirmation.h"
+
+#undef NDEBUG
+#include <cassert>
+#include <initializer_list>
+
+int main() {
+  greeter::PowerConfirmation dialog;
+  assert(!dialog.accept());
+  for (auto action : {greeter::PowerAction::Shutdown, greeter::PowerAction::Reboot, greeter::PowerAction::Firmware}) {
+    dialog.request(action);
+    assert(dialog.active());
+    dialog.cancel();
+    assert(!dialog.active());
+    assert(!dialog.accept());
+    dialog.request(action);
+    assert(dialog.accept() == action);
+    assert(!dialog.accept());
+  }
+}
diff --git a/tests/style_test.cpp b/tests/style_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/style_test.cpp
@@ -0,0 +1,22 @@
+#include "ui/style.h"
+
+#undef NDEBUG
+#include <cassert>
+#include <cmath>
+#include <limits>
+#include <initializer_list>
+
+int main() {
+  Style::setUiScale(1.0f);
+  const float control = Style::controlHeight();
+  const float icon = Style::scaled(64.0f);
+  Style::setFontScale(20.0f / 21.0f);
+  assert(std::abs(Style::fontSizeBody() - 40.0f / 3.0f) < 0.0001f);
+  assert(std::abs(Style::fontSizeCaption() - 260.0f / 21.0f) < 0.0001f);
+  assert(Style::controlHeight() == control);
+  assert(Style::scaled(64.0f) == icon);
+  for (float invalid : {0.0f, -1.0f, std::numeric_limits<float>::infinity(), std::numeric_limits<float>::quiet_NaN()}) {
+    Style::setFontScale(invalid);
+    assert(Style::fontSizeBody() == 14.0f);
+  }
+}
