+++ b/src/dbus/network/route_preference.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#include <cstdint>
+#include <limits>
+#include <span>
+
+namespace route_preference {
+
+  // The kernel's main-table default routes, after filtering out non-unicast routes.
+  struct DefaultRoute {
+    int family; // 4 or 6
+    unsigned int ifindex;
+    std::uint32_t metric;
+  };
+
+  // A single network glyph is only truthful when the two address families agree.
+  // An absent family does not prevent the available one from selecting the icon.
+  inline unsigned int selectInterface(std::span<const DefaultRoute> routes) {
+    unsigned int ipv4 = 0;
+    unsigned int ipv6 = 0;
+    bool ipv4Ambiguous = false;
+    bool ipv6Ambiguous = false;
+    std::uint32_t ipv4Metric = std::numeric_limits<std::uint32_t>::max();
+    std::uint32_t ipv6Metric = std::numeric_limits<std::uint32_t>::max();
+    for (const auto& route : routes) {
+      if (route.ifindex == 0) {
+        continue;
+      }
+      if (route.family == 4 && route.metric < ipv4Metric) {
+        ipv4 = route.ifindex;
+        ipv4Metric = route.metric;
+        ipv4Ambiguous = false;
+      } else if (route.family == 6 && route.metric < ipv6Metric) {
+        ipv6 = route.ifindex;
+        ipv6Metric = route.metric;
+        ipv6Ambiguous = false;
+      } else if (route.family == 4 && route.metric == ipv4Metric && route.ifindex != ipv4) {
+        ipv4Ambiguous = true; // equal-cost routes have no single preferred interface
+      } else if (route.family == 6 && route.metric == ipv6Metric && route.ifindex != ipv6) {
+        ipv6Ambiguous = true;
+      }
+    }
+    if (ipv4Ambiguous || ipv6Ambiguous) {
+      return 0;
+    }
+    if (ipv4 != 0 && ipv6 != 0 && ipv4 != ipv6) {
+      return 0;
+    }
+    return ipv4 != 0 ? ipv4 : ipv6;
+  }
+
+} // namespace route_preference
