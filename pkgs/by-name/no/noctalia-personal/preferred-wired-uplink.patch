+#pragma once
+
+#include "app/poll_source.h"
+#include "dbus/network/iwd_service.h"
+
+class IwdRoutePollSource final : public PollSource {
+public:
+  explicit IwdRoutePollSource(IwdService& service) : m_service(service) {}
+
+  void dispatch(const std::vector<pollfd>& fds, std::size_t startIdx) override {
+    if (m_service.routeMonitorFd() >= 0 && (fds[startIdx].revents & (POLLIN | POLLERR | POLLHUP)) != 0) {
+      m_service.handleRouteEvents();
+    }
+  }
+
+protected:
+  void doAddPollFds(std::vector<pollfd>& fds) override {
+    if (m_service.routeMonitorFd() >= 0) {
+      fds.push_back({.fd = m_service.routeMonitorFd(), .events = POLLIN, .revents = 0});
+    }
+  }
+
+private:
+  IwdService& m_service;
+};
