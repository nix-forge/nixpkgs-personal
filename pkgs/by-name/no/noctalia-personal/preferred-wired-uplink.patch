+  struct OwnedFd {
+    int fd = -1;
+    ~OwnedFd() { if (fd >= 0) { ::close(fd); } }
+  };
+
+  bool readDefaultRoutes(int fd, int family, std::uint32_t sequence,
+                         std::vector<route_preference::DefaultRoute>& routes) {
+    struct {
+      nlmsghdr header;
+      rtmsg route;
+    } request{};
+    request.header.nlmsg_len = NLMSG_LENGTH(sizeof(rtmsg));
+    request.header.nlmsg_type = RTM_GETROUTE;
+    request.header.nlmsg_flags = NLM_F_REQUEST | NLM_F_DUMP;
+    request.header.nlmsg_seq = sequence;
+    request.route.rtm_family = static_cast<unsigned char>(family);
+    sockaddr_nl kernel{.nl_family = AF_NETLINK};
+    if (::sendto(fd, &request, request.header.nlmsg_len, 0,
+                 reinterpret_cast<sockaddr*>(&kernel), sizeof(kernel)) < 0) {
+      return false;
+    }
+
+    alignas(nlmsghdr) char buffer[32768];
+    for (;;) {
+      const ssize_t received = ::recv(fd, buffer, sizeof(buffer), 0);
+      if (received <= 0) {
+        return false;
+      }
+      int remaining = static_cast<int>(received);
+      for (auto* message = reinterpret_cast<nlmsghdr*>(buffer); NLMSG_OK(message, remaining);
+           message = NLMSG_NEXT(message, remaining)) {
+        if (message->nlmsg_seq != sequence) {
+          continue;
+        }
+        if (message->nlmsg_type == NLMSG_DONE) {
+          return true;
+        }
+        if (message->nlmsg_type == NLMSG_ERROR) {
+          return false;
+        }
+        if (message->nlmsg_type != RTM_NEWROUTE || message->nlmsg_len < NLMSG_LENGTH(sizeof(rtmsg))) {
+          continue;
+        }
+        const auto* route = reinterpret_cast<const rtmsg*>(NLMSG_DATA(message));
+        if (route->rtm_dst_len != 0 || route->rtm_type != RTN_UNICAST) {
+          continue;
+        }
+        std::uint32_t table = route->rtm_table;
+        std::uint32_t metric = 0;
+        std::uint32_t output = 0;
+        bool multipath = false;
+        int attributes = static_cast<int>(RTM_PAYLOAD(message));
+        for (auto* attr = RTM_RTA(route); RTA_OK(attr, attributes); attr = RTA_NEXT(attr, attributes)) {
+          if (attr->rta_type == RTA_TABLE && RTA_PAYLOAD(attr) >= sizeof(table)) {
+            std::memcpy(&table, RTA_DATA(attr), sizeof(table));
+          } else if (attr->rta_type == RTA_PRIORITY && RTA_PAYLOAD(attr) >= sizeof(metric)) {
+            std::memcpy(&metric, RTA_DATA(attr), sizeof(metric));
+          } else if (attr->rta_type == RTA_OIF && RTA_PAYLOAD(attr) >= sizeof(output)) {
+            std::memcpy(&output, RTA_DATA(attr), sizeof(output));
+          } else if (attr->rta_type == RTA_MULTIPATH) {
+            multipath = true;
+          }
+        }
+        if (table == RT_TABLE_MAIN && multipath) {
+          return false; // an ECMP route cannot be represented by one interface
+        }
+        if (table == RT_TABLE_MAIN && output != 0) {
+          routes.push_back({family == AF_INET ? 4 : 6, output, metric});
+        }
+      }
+    }
+  }
+
+  std::string preferredWiredInterface() {
+    OwnedFd socket{::socket(AF_NETLINK, SOCK_RAW | SOCK_CLOEXEC, NETLINK_ROUTE)};
+    if (socket.fd < 0) {
+      return {};
+    }
+    sockaddr_nl local{.nl_family = AF_NETLINK};
+    if (::bind(socket.fd, reinterpret_cast<sockaddr*>(&local), sizeof(local)) < 0) {
+      return {};
+    }
+    timeval timeout{.tv_sec = 0, .tv_usec = 250000};
+    (void)::setsockopt(socket.fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+    std::vector<route_preference::DefaultRoute> routes;
+    if (!readDefaultRoutes(socket.fd, AF_INET, 1, routes)
+        || !readDefaultRoutes(socket.fd, AF_INET6, 2, routes)) {
+      return {};
+    }
+    const unsigned int index = route_preference::selectInterface(routes);
+    char name[IF_NAMESIZE]{};
+    if (index == 0 || ::if_indextoname(index, name) == nullptr) {
+      return {};
+    }
+    const std::filesystem::path link = std::filesystem::path("/sys/class/net") / name;
+    // Only show a physical wired uplink. VPNs, bridges, and Wi-Fi must not be
+    // relabeled Ethernet just because they happen to own a default route.
+    if (!std::filesystem::exists(link / "device") || std::filesystem::exists(link / "wireless")) {
+      return {};
+    }
+    std::ifstream typeFile(link / "type");
+    unsigned int hardwareType = 0;
+    if (!(typeFile >> hardwareType) || hardwareType != 1) { // ARPHRD_ETHER
+      return {};
+    }
+    return name;
+  }
+
