+void MediaTab::doLayout(Renderer& renderer, float width, float height) {
+  if (m_root == nullptr || m_scroll == nullptr) {
+    return;
+  }
+  m_root->setSize(width, height);
+  m_root->layout(renderer);
+  const float cardWidth = std::max(1.0F, m_scroll->contentViewportWidth());
+  // Reserve identical artwork, padding, and transport columns for every card.
+  const float fixedWidth = (72.0F + 4.0F * Style::spaceMd + 3.0F * 36.0F + 2.0F * Style::spaceXs) * contentScale();
+  const float textWidth = std::max(1.0F, cardWidth - fixedWidth);
+  for (auto& card : m_cards) {
+    card.root->setMinWidth(cardWidth);
+    card.details->setMinWidth(textWidth);
+    card.details->setMaxWidth(textWidth);
+    card.source->setMaxWidth(textWidth);
+    card.title->setMaxWidth(textWidth);
+    card.artist->setMaxWidth(textWidth);
+  }
+  m_root->layout(renderer);
