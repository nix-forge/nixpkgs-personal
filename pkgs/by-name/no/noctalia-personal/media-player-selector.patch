+void MediaTab::rebuild(const std::vector<MprisPlayerInfo>& players) {
+  while (!m_list->children().empty()) {
+    m_list->removeChild(m_list->children().back().get());
+  }
+  m_cards.clear();
+  m_initialized = true;
+  const float scale = contentScale();
+  if (players.empty()) {
+    m_list->addChild(
+        ui::label(
+            {.text = "Nothing playing",
+             .fontSize = Style::fontSizeTitle * scale,
+             .color = colorSpecFromRole(ColorRole::OnSurfaceVariant)}
+        )
+    );
+    return;
+  }
+  for (const auto& player : players) {
+    Card card;
+    card.busName = player.busName;
+    auto root = ui::column({
+        .out = &card.root,
+        .align = FlexAlign::Stretch,
+        .gap = Style::spaceSm * scale,
+        .configure = [scale, opacity = panelCardOpacity()](Flex& node) { applySectionCardStyle(node, scale, opacity); },
+    });
+    auto content = ui::row({.align = FlexAlign::Center, .gap = Style::spaceMd * scale, .fillWidth = true});
+    content->addChild(
+        ui::image(
+            {.out = &card.artwork,
+             .fit = ImageFit::Cover,
+             .radius = Style::scaledRadiusMd(scale),
+             .width = 72.0F * scale,
+             .height = 72.0F * scale,
+             .visible = false,
+             .participatesInLayout = false}
+        )
+    );
+    auto placeholder = ui::column({
+        .out = &card.placeholder,
+        .align = FlexAlign::Center,
+        .justify = FlexJustify::Center,
+        .minWidth = 72.0F * scale,
+        .minHeight = 72.0F * scale,
+        .maxWidth = 72.0F * scale,
+        .maxHeight = 72.0F * scale,
+    });
+    placeholder->addChild(
+        ui::glyph({
+            .glyph = "music",
+            .glyphSize = 32.0F * scale,
+            .color = colorSpecFromRole(ColorRole::OnSurfaceVariant),
+        })
+    );
+    content->addChild(std::move(placeholder));
+    auto details = ui::column(
+        {.out = &card.details, .align = FlexAlign::Stretch, .gap = Style::spaceXs * scale, .flexGrow = 1.0F}
+    );
+    details->addChild(
+        ui::label(
+            {.out = &card.source,
+             .fontSize = Style::fontSizeCaption * scale,
+             .color = colorSpecFromRole(ColorRole::OnSurfaceVariant),
+             .maxLines = 1}
+        )
+    );
+    details->addChild(
+        ui::label(
+            {.out = &card.title,
+             .fontSize = Style::fontSizeTitle * scale,
+             .fontWeight = FontWeight::Bold,
+             .color = colorSpecFromRole(ColorRole::OnSurface),
+             .maxLines = 1}
+        )
+    );
+    details->addChild(
+        ui::label(
+            {.out = &card.artist,
+             .fontSize = Style::fontSizeBody * scale,
+             .color = colorSpecFromRole(ColorRole::OnSurfaceVariant),
+             .maxLines = 1}
+        )
+    );
+    content->addChild(std::move(details));
+    auto actions = ui::row({.align = FlexAlign::Center, .gap = Style::spaceXs * scale});
+    const auto bus = player.busName;
+    auto action = [this, scale, &actions, bus](Button** out, const std::string& glyph, int command, float size) {
+      actions->addChild(
+          ui::button({
+              .out = out,
+              .glyph = glyph,
+              .glyphSize = size * scale,
+              .variant = ButtonVariant::Ghost,
+              .minWidth = 36.0F * scale,
+              .minHeight = 36.0F * scale,
+              .padding = Style::spaceXs * scale,
+              .onClick = [this, bus, command]() { control(bus, command); },
+          })
+      );
+    };
+    action(&card.previous, "media-prev", 0, 18.0F);
+    action(&card.playPause, "media-play", 1, 26.0F);
+    action(&card.next, "media-next", 2, 18.0F);
+    content->addChild(std::move(actions));
+    root->addChild(std::move(content));
+    auto timeline =
+        ui::row({.out = &card.timeline, .align = FlexAlign::Center, .gap = Style::spaceSm * scale, .fillWidth = true});
+    timeline->addChild(
+        ui::label(
+            {.out = &card.elapsed,
+             .fontSize = Style::fontSizeCaption * scale,
+             .color = colorSpecFromRole(ColorRole::OnSurfaceVariant),
+             .minWidth = 42.0F * scale,
+             .maxWidth = 42.0F * scale,
+             .textAlign = TextAlign::Start}
+        )
+    );
+    timeline->addChild(
+        ui::slider({
+            .out = &card.progress,
+            .minValue = 0.0,
+            .maxValue = 1.0,
+            .step = 0.1,
+            .trackHeight = 3.0F * scale,
+            .thumbSize = 10.0F * scale,
+            .controlHeight = 18.0F * scale,
+            .wheelAdjustEnabled = false,
+            .flexGrow = 1.0F,
+            .onValueChanged = [this, bus](double seconds) {
+              if (!m_syncingProgress) {
+                seek(bus, seconds);
+              }
+            },
+        })
+    );
+    timeline->addChild(
+        ui::label(
+            {.out = &card.duration,
+             .fontSize = Style::fontSizeCaption * scale,
+             .color = colorSpecFromRole(ColorRole::OnSurfaceVariant),
+             .minWidth = 42.0F * scale,
+             .maxWidth = 42.0F * scale,
+             .textAlign = TextAlign::End}
+        )
+    );
+    // This small pin controls media-key routing only. Each card's controls
+    // always address its own MPRIS endpoint, including identical app names.
+    timeline->addChild(
