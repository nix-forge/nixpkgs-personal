+#[cfg(all(test, target_os = "linux"))]
+mod nix_process_locale_tests {
+    use super::*;
+    #[test]
+    fn only_pgrep_gets_a_utf8_matching_locale() {
+        let pgrep = command("pgrep");
+        assert!(pgrep.get_envs().any(|(key, value)| key == "LC_ALL" && value == Some(std::ffi::OsStr::new("C.UTF-8"))));
