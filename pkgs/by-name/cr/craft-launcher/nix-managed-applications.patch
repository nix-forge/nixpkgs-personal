@@ -0,0 +1,51 @@
+//! Read-only discovery of applications installed through Nix profiles.
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+use artcraft_launcher_core::{CraftApp, InstallSource, Installed, version};
+
+pub fn is_store_path(path: &Path) -> bool {
+    path.strip_prefix("@nixStoreDir@").is_ok_and(|relative| relative.components().count() >= 2)
+}
+
+pub fn detect(app: &CraftApp) -> Option<Installed> {
+    let path = std::env::var_os("PATH")?;
+    let executable = std::env::split_paths(&path).map(|directory| directory.join(app.id)).find(|candidate| candidate.is_file())?;
+    let canonical = executable.canonicalize().ok()?;
+    if !is_store_path(&canonical) { return None; }
+    let cli = executable.parent()?.join(format!("{}-cli", app.id));
+    let current = if cli.is_file() {
+        crate::process::capture(cli.to_str()?, &["--version"], Duration::from_secs(5))
+            .and_then(|output| output.split_whitespace().nth(1).and_then(version::parse))
+    } else { None };
+    // Opening the bundle preserves Launch Services and executable-relative resources on macOS.
+    let location = if cfg!(target_os = "macos") {
+        canonical.ancestors().find(|path| path.extension().is_some_and(|extension| extension == "app"))
+            .map(Path::to_path_buf).unwrap_or(canonical)
+    } else { PathBuf::from(&executable) };
+    Some(Installed { version: current, source: InstallSource::Nix, location: location.display().to_string(), package: Some(app.id.to_owned()) })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn immutable_store_paths_have_an_output_and_a_file() {
+        assert!(is_store_path(Path::new("@nixStoreDir@/hash-photocraft/bin/photocraft")));
+        assert!(is_store_path(Path::new("@nixStoreDir@/hash-photocraft/Applications/PhotoCraft.app/Contents/MacOS/PhotoCraft")));
+        assert!(!is_store_path(Path::new("@nixStoreDir@")));
+        assert!(!is_store_path(Path::new("@nixStoreDir@/hash-photocraft")));
+        assert!(!is_store_path(Path::new("/tmp/nix/store/hash/bin/photocraft")));
+        assert!(!is_store_path(Path::new("@nixStoreDir@front/hash/bin/photocraft")));
+    }
+    #[test]
+    fn nix_ownership_never_allows_launcher_updates_or_removal() {
+        let app = CraftApp::by_id("photocraft").unwrap();
+        let installed = Installed { version: None, source: InstallSource::Nix, location: String::new(), package: Some(app.id.to_owned()) };
+        assert!(!installed.source.launcher_can_update());
+        assert_eq!(installed.source.label(), "Nix package");
+        for uninstall in [false, true] {
+            let reason = crate::install::managed_elsewhere(app, &installed, uninstall).unwrap();
+            assert!(reason.contains("through your Nix configuration"));
+        }
+    }
+}
