+    pub(crate) fn refresh_owned_menu_entry(data: &Path, app: &CraftApp, image: &Path, runner: &Path) {
+        let desktop = desktop_path(data, app);
+        if !image.is_file() || !std::fs::symlink_metadata(&desktop).is_ok_and(|m| m.is_file()) {
+            return;
+        }
+        let Ok(old) = std::fs::read_to_string(&desktop) else { return };
+        if !crate::desktop_entry::is_ours(&old) {
+            return;
+        }
+        let icon = icon_path(data, app).is_file();
+        let Some(text) = crate::desktop_entry::render_with_runner(app, image, icon, Some(runner)) else { return };
