+        let legacy = text
+            .replacen(&prefix, "Exec=", 1)
+            .lines()
+            .filter(|line| !line.starts_with("TryExec="))
+            .map(|line| format!("{line}\n"))
+            .collect::<String>();
+        let bare_env = text.replacen(&format!("Exec={env} "), "Exec=env ", 1);
+        if direct.as_deref() != Some(old.as_str()) && legacy != old && bare_env != old {
+            return; // Includes changed Name/Comment, extra Exec args, and another target.
+        }
