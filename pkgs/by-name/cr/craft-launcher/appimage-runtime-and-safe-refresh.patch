+/// The pinned AppImage runtime in native Linux builds.
+pub(crate) fn appimage_runner() -> Option<&'static std::ffi::OsStr> {
+    if !cfg!(target_os = "linux") {
+        return None;
+    }
+    option_env!("CRAFT_LAUNCHER_APPIMAGE_RUN").filter(|path| !path.is_empty()).map(std::ffi::OsStr::new)
+}
+
+pub(crate) fn launch_appimage(
+    runner: &std::ffi::OsStr, app_id: &str, image: &Path, args: &[String], env: &[(&str, &std::ffi::OsStr)],
+) -> Result<(), String> {
+    let mut cmd = command(runner);
+    cmd.arg(image).args(args).envs(env.iter().copied());
+    cmd.env(format!("{}_NO_DESKTOP_INTEGRATION", app_id.to_ascii_uppercase()), "1");
+    if let Some(dir) = image.parent() {
+        cmd.current_dir(dir);
+    }
+    spawn_detached(cmd)
+}
