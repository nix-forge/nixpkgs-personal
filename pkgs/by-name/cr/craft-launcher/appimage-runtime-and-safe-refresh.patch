+    /// Refresh only exact canonical entries; user-edited fields and arguments stay untouched.
+    pub fn refresh_menu_entries(manifest: &crate::manifest::Manifest) {
+        if process::in_sandbox() {
+            return;
+        }
+        let (Some(runner), Some(data)) = (process::appimage_runner(), host_data_dir()) else { return };
+        for (id, record) in &manifest.apps {
+            if record.kind == PackageKind::AppImage
+                && let Some(app) = CraftApp::by_id(id)
+            {
+                refresh_owned_menu_entry(&data, app, &record.path, Path::new(runner));
+            }
+        }
+    }
+
+    pub(crate) fn refresh_owned_menu_entry(data: &Path, app: &CraftApp, image: &Path, runner: &Path) {
+        let desktop = desktop_path(data, app);
+        if !image.is_file() || !std::fs::symlink_metadata(&desktop).is_ok_and(|m| m.is_file()) {
+            return;
+        }
+        let Ok(old) = std::fs::read_to_string(&desktop) else { return };
+        if !crate::desktop_entry::is_ours(&old) {
+            return;
+        }
+        let icon = icon_path(data, app).is_file();
+        let Some(text) = crate::desktop_entry::render_with_runner(app, image, icon, Some(runner)) else { return };
+        if text == old {
+            return;
+        }
+        let direct = crate::desktop_entry::render_with_runner(app, image, icon, None);
+        // Our earlier Nix entry used this same pinned helper without an AppRun opt-out.
+        let Some(env) = crate::desktop_entry::exec_quote(Path::new(crate::desktop_entry::env_program())) else { return };
+        let prefix = format!("Exec={env} {}_NO_DESKTOP_INTEGRATION=1 ", app.id.to_ascii_uppercase());
+        let legacy = text
+            .replacen(&prefix, "Exec=", 1)
+            .lines()
+            .filter(|line| !line.starts_with("TryExec="))
+            .map(|line| format!("{line}\n"))
+            .collect::<String>();
+        let bare_env = text.replacen(&format!("Exec={env} "), "Exec=env ", 1);
+        if direct.as_deref() != Some(old.as_str()) && legacy != old && bare_env != old {
+            return; // Includes changed Name/Comment, extra Exec args, and another target.
+        }
+        if let Err(e) = crate::paths::write_atomic(&desktop, text.as_bytes()) {
+            log::warn!("{}: couldn't refresh the menu entry: {e}", app.name);
+        }
+    }
+
     fn desktop_path(data: &Path, app: &CraftApp) -> PathBuf {
         data.join("applications").join(format!("{}.desktop", app.bundle_id()))
     }
