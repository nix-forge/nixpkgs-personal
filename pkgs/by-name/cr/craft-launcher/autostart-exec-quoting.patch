+#[cfg(not(any(target_os = "macos", windows)))]
+fn autostart_entry(program: &std::path::Path) -> Result<String, String> {
+    let quoted = crate::desktop_entry::exec_quote(program).ok_or("this executable cannot be represented in a desktop entry")?;
+    Ok(format!("[Desktop Entry]\nType=Application\nName=ArtCraft Launcher\nComment=Install and update the Craft App Suite\nExec={quoted} {HIDDEN_FLAG}\nIcon={ID}\nTerminal=false\nX-GNOME-Autostart-enabled=true\n"))
