+#[cfg(any(test, target_os = "macos"))]
+fn prefer_nix_installation(mut installations: Vec<Installed>) -> Option<Installed> {
+    if let Some(index) = installations.iter().position(|installed| installed.source == InstallSource::Nix) {
+        Some(installations.swap_remove(index))
+    } else {
+        installations.into_iter().next()
+    }
+}
