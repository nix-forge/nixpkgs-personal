+def peer_cooldowns():
+    path = os.path.join(os.environ.get("STATE_DIRECTORY", "."), "peer-cooldowns.json")
+    try:
+        with open(path) as handle:
+            data = json.load(handle)
+    except FileNotFoundError:
+        data = {}
+    return path, {user: expiry for user, expiry in data.items() if expiry > time.time()}
+
+
+def cooldown_peer(username):
+    path, data = peer_cooldowns()
+    data[username] = time.time() + 7200
+    temporary = path + ".tmp"
+    with open(temporary, "w") as handle:
+        json.dump(data, handle)
+    os.replace(temporary, path)
+
