+def prepare_lidarr_release(album_id, release_id):
+    """Import the complete matched edition without overriding a pinned edition."""
+    album = lidarr.get_album(album_id)
+    release = next(r for r in album["releases"] if r["id"] == release_id)
+    if release.get("monitored"):
+        return
+    if not album.get("anyReleaseOk", False):
+        raise RuntimeError("Requested edition changed during download; files preserved")
+    for candidate in album["releases"]:
+        candidate["monitored"] = candidate["id"] == release_id
+    lidarr.upd_album(album)
 
 
