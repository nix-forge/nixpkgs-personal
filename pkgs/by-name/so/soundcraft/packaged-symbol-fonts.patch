+#[cfg(all(test, target_os = "linux"))]
+mod packaged_font_tests {
+    use super::*;
+
+    #[test]
+    fn packaged_regular_and_bold_faces_cover_ui_symbols() -> Result<(), Box<dyn std::error::Error>> {
+        // Read immutable package inputs directly: host fonts and the process environment
+        // must not determine whether the packaged fallback has these glyphs.
+        let read = |path| -> std::io::Result<FontData> { Ok(FontData::from_owned(std::fs::read(path)?)) };
+        let definitions = definitions_with_system_fonts(
+            Some(read("@soundcraftDejaVu@/share/fonts/truetype/DejaVuSans.ttf")?),
+            Some(read("@soundcraftDejaVu@/share/fonts/truetype/DejaVuSans-Bold.ttf")?),
+            None,
+        );
+        for (family, name) in [(FontFamily::Proportional, "system-regular"), (FontFamily::Name("bold".into()), "system-bold")] {
+            assert_eq!(definitions.families[&family].first().map(String::as_str), Some(name));
+            // Isolate the selected face so egui's bundled fonts cannot hide a missing glyph.
+            let mut isolated = FontDefinitions::default();
+            isolated.font_data.clear();
+            isolated.families.clear();
+            isolated.font_data.insert(name.into(), definitions.font_data[name].clone());
+            isolated.families.insert(family.clone(), vec![name.into()]);
+            let mut fonts = egui::epaint::text::Fonts::new(Default::default(), isolated);
+            let font_id = egui::FontId::new(16.0, family);
+            let mut view = fonts.with_pixels_per_point(1.0);
+            {
+                // epaint 0.36.2 has_glyph falsely rejects glyphs in its replacement face.
+                let mut face = view.fonts.font(&font_id.family);
+                let characters = face.characters();
+                for glyph in ['▸', '▾', '♯', '✕'] {
+                    assert!(characters.contains_key(&glyph), "{name} is missing {glyph}");
+                }
+            }
+            for glyph in ['▸', '▾', '♯', '✕'] {
+                let width = view.glyph_width(&font_id, glyph);
+                assert!(width.is_finite() && width > 0.0, "{name} cannot measure {glyph}");
+            }
+        }
+        Ok(())
+    }
+}
