const QUIT_TIMEOUT_MS = 3e3;
const mpvDeviceQuery = async (mpv) => {
  let timer;
  try {
    return await Promise.race([
      mpv.getProperty("audio-device-list"),
      new Promise((_, reject) => {
        timer = setTimeout(() => reject({ errcode: 5 }), QUIT_TIMEOUT_MS);
      })
    ]);
  } finally {
    clearTimeout(timer);
  }
};
