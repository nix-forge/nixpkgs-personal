+#[test]
+fn transparency_inspection_ignores_binary_image_data() {
+    use vectorcraft_testkit::pdf::{PdfPage, first_extra, pdf_with};
+    let mut page = PdfPage::new(1.0, 1.0, "/Fixture Do");
+    page.resources = format!("/XObject << /Fixture {} 0 R >>", first_extra(1));
+    // Three valid RGB samples happen to spell a PDF dictionary key.
+    let image = "<< /Type /XObject /Subtype /Image /Width 1 /Height 1 /ColorSpace /DeviceRGB /BitsPerComponent 8 /Length 3 >>\nstream\n/BM\nendstream";
+    assert!(transparency(&pdf_with(&[page], &[image], None)).is_empty());
+}
