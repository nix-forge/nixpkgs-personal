+// Like the writer's PDF/X verification, this is scoped to generated PDF syntax.
+fn pdf_objects(pdf: &[u8]) -> Vec<u8> {
+    let find = |needle: &[u8], from: usize| pdf.get(from..)?.windows(needle.len()).position(|part| part == needle).map(|at| from + at);
+    let mut objects = Vec::new();
+    let mut at = 0;
+    while let Some(stream) = find(b"stream", at) {
+        let data = stream + b"stream".len();
+        objects.extend_from_slice(&pdf[at..data]);
+        at = if (stream >= 3 && pdf.get(stream - 3..stream) == Some(b"end"))
+            || !pdf.get(data).is_some_and(|byte| matches!(byte, b'\r' | b'\n'))
+        {
+            data
+        } else {
+            find(b"endstream", data).unwrap_or(pdf.len())
+        };
+    }
+    objects.extend_from_slice(&pdf[at..]);
+    objects
+}
+
+fn name_values<'a>(objects: &'a [u8], name: &[u8]) -> Vec<&'a [u8]> {
+    let delimiter = |byte: &u8| byte.is_ascii_whitespace() || b"/[]<>()%".contains(byte);
+    objects.windows(name.len()).enumerate().filter_map(|(at, token)| {
+        let end = at + name.len();
+        if token != name || objects.get(end).is_some_and(|byte| !delimiter(byte)) {
+            return None;
+        }
+        let rest = &objects[end..];
+        let rest = &rest[rest.iter().take_while(|byte| byte.is_ascii_whitespace()).count()..];
+        let length = rest.iter().enumerate().take_while(|(index, byte)| *index == 0 || !delimiter(byte)).count();
+        Some(&rest[..length])
+    }).collect()
+}
