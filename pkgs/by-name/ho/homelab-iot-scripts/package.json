{
  "name": "homelab-iot-scripts",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings --config .oxlintrc.json *.cts *.mts",
    "format:check": "prettier --check \"*.{cts,mts,json}\"",
    "test": "node dist/scrypted-plugin-install.test.cjs && node dist/scrypted-managed-settings.test.cjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
