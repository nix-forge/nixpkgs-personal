// Use the calling package's directory for dependencies, matching node -e.
import { createRequire } from "node:module";
import path from "node:path";
import { pathToFileURL } from "node:url";

async function main(): Promise<void> {
  const [mode, ...names] = process.argv.slice(2);
  if (!mode || names.length === 0) {
    throw new Error("usage: check_node_modules.mts MODE MODULE [MODULE ...]");
  }
  const requirePackage = createRequire(
    path.join(process.cwd(), "package.json"),
  );
  if (mode === "require") {
    for (const name of names) requirePackage(name);
  } else if (mode === "plugin-cjs") {
    for (const name of names) {
      if (typeof requirePackage(name) !== "function") {
        throw new Error("Homebridge plugin entrypoint missing");
      }
    }
  } else if (mode === "plugin-esm") {
    for (const name of names) {
      // Preserve provider initialization order in these import smoke checks.
      const plugin: unknown = await import(
        pathToFileURL(path.resolve(name)).href
      );
      if (
        plugin === null ||
        typeof plugin !== "object" ||
        !("default" in plugin) ||
        typeof plugin.default !== "function"
      ) {
        throw new Error("Homebridge plugin entrypoint missing");
      }
    }
  } else {
    throw new Error(`unknown module check mode: ${mode}`);
  }
}

main().catch((error) => {
  console.error(error);
  process.exitCode = 1;
});
