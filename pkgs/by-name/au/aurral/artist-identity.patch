+// Promote already enriched legacy name keys and merge persisted same-MBID rows.
+export function repairLibraryArtistIdentities() {
+  return db.transaction(() => {
+    const rows = db.prepare<[], LibraryArtistsRow>(
+      "SELECT * FROM library_artists WHERE mbid IS NOT NULL AND mbid <> '' AND identity_key <> 'mbid:' || mbid",
+    ).all();
+    for (const row of rows) {
+      const identityKey = `mbid:${row.mbid}`;
+      const resolved = db.prepare<[string], LibraryArtistsRow>(
+        "SELECT * FROM library_artists WHERE identity_key = ?",
+      ).get(identityKey) || row;
+      upsertLibraryArtist({ identityKey, mbid: row.mbid, name: resolved.name,
+        sortName: resolved.sort_name, metadata: readRawLibraryMetadata(resolved.metadata_json) });
+    }
+  })();
 }
 
