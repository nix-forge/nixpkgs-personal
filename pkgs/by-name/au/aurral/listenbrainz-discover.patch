+import { useEffect, useState } from "react";
+import { useQuery } from "@tanstack/react-query";
+import { playlistStatusQueryOptions } from "../queryOptions.ts";
+import { parseResponse } from "hono/client";
+import { discoveryClient } from "../utils/api/clients/discovery.ts";
+import { staticPlaylistsClient } from "../utils/api/clients/staticPlaylists.ts";
+import { useAuth } from "../contexts/AuthContext";
+import { useToast } from "../contexts/ToastContext";
+import { DiscoverRail } from "../components/DiscoverRail";
+import RouteLink from "../components/RouteLink";
+import { SettingsLink } from "./Settings/settingsRoute";
+
+type Track = { artistName: string; trackName: string; albumName?: string | null;
+  artistMbid?: string | null; albumMbid?: string | null; releaseMbid?: string | null;
+  trackMbid?: string | null; coverUrl?: string | null; listenCount?: number };
+type Album = { name: string; artistName: string; albumMbid: string | null; coverUrl: string | null };
+type Shelf = { configured: boolean; unavailable: boolean; global: Track[]; personal: Track[]; personalRange: string;
+  recommendedTracks: Track[]; trendingAlbums: Album[];
+  playlists: { id: string; name: string; tracks: Track[] }[] };
+
+export function DiscoverListenBrainzSection() {
+  const { user, hasPermission } = useAuth();
+  const { showSuccess, showError } = useToast();
+  const [saving, setSaving] = useState<{ name: string; playlistId: string; startedAt: number } | null>(null);
+  const [submitting, setSubmitting] = useState(false);
+  const [names, setNames] = useState<Record<string, string>>({});
+  const operation = useQuery({
+    ...playlistStatusQueryOptions(),
+    enabled: saving !== null,
+    refetchInterval: saving !== null ? 1000 : false,
+    retry: 2,
+  });
+  useEffect(() => {
+    if (!saving) return;
+    if (operation.data?.sharedPlaylists?.some((playlist) => playlist.id === saving.playlistId)) {
+      showSuccess(`Added ${saving.name} to Playlists.`);
+      setSaving(null);
+    } else if (operation.error || Date.now() - saving.startedAt > 60_000) {
+      showError("Couldn't confirm this save. Check Playlists before retrying with another name.");
+      setSaving(null);
+    }
+  }, [saving, operation.data, operation.dataUpdatedAt, operation.error, showError, showSuccess]);
+  const { data, isPending, error, refetch } = useQuery({
+    queryKey: ["listenbrainz-recording-shelves", user?.id],
+    enabled: Boolean(user), staleTime: 5 * 60 * 1000,
+    queryFn: async ({ signal }) => parseResponse(discoveryClient.listenbrainz.$get({}, { init: { signal } })) as Promise<Shelf>,
+  });
+  async function save(name: string, tracks: Track[]) {
+    const requestedName = (names[name] ?? name).trim();
+    if (!requestedName) { showError("Enter a playlist name."); return; }
+    setSubmitting(true);
+    try {
+      const current = await operation.refetch({ throwOnError: true });
+      if ([...(current.data?.sharedPlaylists ?? []), ...(current.data?.flows ?? [])].some((playlist) => playlist.ownerUserId === user?.id && playlist.name.trim().toLowerCase() === requestedName.toLowerCase())) {
+        showError("A playlist with that name already exists. Enter another name.");
+        return;
+      }
+      const result = await parseResponse(staticPlaylistsClient["shared-playlists"].$post({
+        json: { name: requestedName, sourceName: "ListenBrainz", tracks },
+      }));
+      setSaving({ name: requestedName, playlistId: result.playlistId, startedAt: Date.now() });
+    } catch { showError("Couldn't submit this playlist. Try again."); }
+    finally { setSubmitting(false); }
+  }
+  if (isPending) return <p role="status">Loading ListenBrainz charts…</p>;
+  if (error) return <div role="alert">ListenBrainz charts didn't load. <button className="btn btn-secondary btn-sm" onClick={() => refetch()}>Try again</button></div>;
+  if (!data) return null;
+  const rows = [
+    { name: data.personalRange === "recent" ? "Your Recent Top Songs" : "Your Most Played", tracks: data.personal },
+    { name: "ListenBrainz Trending", tracks: data.global },
+    { name: "Recommended Songs", tracks: data.recommendedTracks },
+    ...data.playlists.map((playlist) => ({ name: playlist.name, tracks: playlist.tracks })),
+  ];
+  return <section aria-label="ListenBrainz charts and playlists">
+    {data.unavailable ? <p role="alert">Some ListenBrainz data couldn't load. <button className="btn btn-secondary btn-sm" onClick={() => refetch()}>Try again</button></p> : null}
+    {!data.configured ? <p>Connect public listening history for personal charts and recommendations. <SettingsLink to="listening/listenbrainz" className="settings-link">ListenBrainz settings</SettingsLink></p> : null}
+    {rows.filter((row) => row.tracks.length).map(({ name, tracks }) => <DiscoverRail key={name} title={name}
+      headerActions={hasPermission("accessFlow") ? <div>
+        <input aria-label={`Playlist name for ${name}`} value={names[name] ?? name}
+          onChange={(event) => setNames((current) => ({ ...current, [name]: event.target.value }))} />
+        <button className="btn btn-secondary btn-sm" disabled={submitting || saving !== null}
+          onClick={() => save(name, tracks)}>{saving !== null ? "Saving…" : "Save playlist"}</button>
+      </div> : null}>
+      {tracks.map((track, index) => <RouteLink key={`${track.trackMbid || track.trackName}:${index}`}
+        className="discover-card" to={`/search?q=${encodeURIComponent(`${track.artistName} ${track.trackName}`)}`}>
+        {track.coverUrl ? <img src={track.coverUrl} alt="" loading="lazy" width={160} height={160} /> : null}
+        <strong>{track.trackName}</strong><span>{track.artistName}</span>
+      </RouteLink>)}
+    </DiscoverRail>)}
+    {data.trendingAlbums.length ? <DiscoverRail title="ListenBrainz Trending Albums">
+      {data.trendingAlbums.map((album, index) => <RouteLink key={album.albumMbid || index} className="discover-card"
+        to={`/search?q=${encodeURIComponent(`${album.artistName} ${album.name}`)}`}>
+        {album.coverUrl ? <img src={album.coverUrl} alt="" loading="lazy" width={160} height={160} /> : null}
+        <strong>{album.name}</strong><span>{album.artistName}</span>
+      </RouteLink>)}
+    </DiscoverRail> : null}
+  </section>;
+}
