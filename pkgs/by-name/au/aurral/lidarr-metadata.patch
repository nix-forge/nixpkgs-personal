+type LidarrMetadataSource = LidarrRootsSource & Partial<Pick<LidarrClient,
+  "getArtists" | "getAllAlbums" | "getAllTracks" | "getTrackFilesByIds" | "getAllTrackFiles">>;
+type ImportedFileMetadata = import("./downloadUtils.ts").DownloadTrackFields & {
+  foreignArtistId?: string | null; foreignAlbumId?: string | null; images?: unknown[] | null;
+};
+// Only exact imported file paths can supply missing identity/artwork.
+export async function getLidarrMetadataByPath(client: LidarrMetadataSource | undefined,
+  { forceRefresh = false } = {}) {
+  const byPath = new Map<string, ImportedFileMetadata>();
+  if (!client?.isConfigured?.() || !client.getArtists || !client.getAllAlbums || !client.getAllTracks || !client.getTrackFilesByIds) return byPath;
+  try {
+    const artists = await client.getArtists({ forceRefresh });
+    const artistIds = artists.map((artist) => artist.id);
+    if (!artistIds.length) return byPath;
+    const [albums, tracks] = await Promise.all([
+      client.getAllAlbums({ artistIds, forceRefresh }),
+      client.getAllTracks({ artistIds, throwOnError: true, forceRefresh }),
+    ]);
+    let files = await client.getTrackFilesByIds(tracks.map((track) => track.trackFileId).filter((id): id is number => typeof id === "number"),
+      { throwOnError: true, forceRefresh }).catch(() => []);
+    if (!files.length && tracks.some((track) => track.trackFileId)) {
+      files = client.getAllTrackFiles ? await client.getAllTrackFiles({ artistIds, throwOnError: true, forceRefresh }) : [];
+    }
+    const byArtist = new Map(artists.map((artist) => [String(artist.id), artist]));
+    const byAlbum = new Map(albums.map((album) => [String(album.id), album]));
+    const byFileId = new Map(files.map((file) => [String(file.id), file]));
+    const byTrackId = new Map<string, (typeof files)[number]>();
+    for (const file of files) for (const id of Array.isArray(file.trackIds) ? file.trackIds : []) byTrackId.set(String(id), file);
+    const ambiguous = new Set<string>();
+    for (const track of tracks) {
+      const file = byFileId.get(String(track.trackFileId)) || byTrackId.get(String(track.id));
+      const album = byAlbum.get(String(track.albumId));
+      const artist = byArtist.get(String(album?.artistId));
+      if (!file?.path || !album || !artist) continue;
+      const localPath = path.resolve(resolveLocalPath(file.path, getPathMappings("lidarr")));
+      if (ambiguous.has(localPath)) continue;
+      const metadata: ImportedFileMetadata = {
+        artistMbid: artist.foreignArtistId, albumMbid: album.foreignAlbumId,
+        trackMbid: track.foreignRecordingId || track.foreignTrackId,
+        foreignArtistId: artist.foreignArtistId, foreignAlbumId: album.foreignAlbumId,
+        images: Array.isArray(album.images) ? album.images : null,
+      };
+      const existing = byPath.get(localPath);
+      if (existing) {
+        if (existing.albumMbid !== metadata.albumMbid || existing.artistMbid !== metadata.artistMbid) {
+          byPath.delete(localPath); ambiguous.add(localPath); continue;
+        }
+        existing.trackMbid = null;
+      } else byPath.set(localPath, metadata);
+    }
+  } catch (error) {
+    logger.warn("library", "Lidarr metadata unavailable; scanning file tags", { reason: String(error) });
+  }
+  return byPath;
+}
