+from decimal import Decimal
+from typing import Annotated, Literal
+from uuid import UUID
+
+from pydantic import BaseModel, ConfigDict, Field, HttpUrl
+
+Text = Annotated[str, Field(max_length=2000)]
+Short = Annotated[str, Field(max_length=100)]
+Tags = Annotated[list[Short], Field(max_length=20)]
+Money = Annotated[Decimal, Field(ge=0, le=99999999, max_digits=10, decimal_places=2)]
+
+
+class Input(BaseModel):
+    model_config = ConfigDict(extra="forbid", str_strip_whitespace=True)
+    version: int = Field(default=0, ge=0)
+
+
+class Review(Input):
+    priority: Literal["low", "normal", "high"] = "normal"
+    suitable_occasions: Tags = []
+    suitable_climates: Tags = []
+    condition: Literal["unknown", "good", "worn", "damaged", "unusable"] = "unknown"
+    fit: Literal["unknown", "good", "tight", "loose", "uncomfortable"] = "unknown"
+    comfort: Literal["unknown", "good", "poor"] = "unknown"
+    decision: Literal["keep", "repair", "alter", "replace", "retire"] = "keep"
+    available: bool = True
+    composition: Text = ""
+    construction: Text = ""
+    defects: Text = ""
+    care: Text = ""
+    measurements: Text = ""
