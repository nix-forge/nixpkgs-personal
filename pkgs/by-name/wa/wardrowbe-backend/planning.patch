+"""Run the extension's separate migration ledger after upstream migrations."""
+
+from pathlib import Path
+
+from alembic import command
+from alembic.config import Config
+
+
+def main():
+    import sys
+
+    if len(sys.argv) > 1:
+        upstream = Config(sys.argv[1])
+        upstream.set_main_option(
+            "script_location", str(Path(sys.argv[1]).resolve().parent / "migrations")
+        )
+        command.upgrade(upstream, "head")
+    config = Config()
+    config.set_main_option("script_location", str(Path(__file__).parent / "migrations"))
+    command.upgrade(config, "head")
+
+
+if __name__ == "__main__":
+    main()
