+    async def test_quality_evidence_reaches_recommendations_pairings_and_comparison(self):
+        evidence = {
+            "composition": "100% cotton",
+            "construction": "Opaque weave; reinforced side seams",
+            "care": "Cold wash; line dry",
+            "measurements": "Shoulders 45 cm",
+        }
+        await self.review(version=0, **evidence)
+        async with async_session_maker() as db:
+            from app.planning.service import eligible_items, prompt_evidence
+
+            shirt = await db.get(ClothingItem, self.shirt.id)
+            trousers = await db.get(ClothingItem, self.trousers.id)
+            await eligible_items(db, self.owner_id, [shirt, trousers])
+            recommendation, _ = RecommendationService(db)._format_items_for_prompt(
+                [shirt], {}, date.today()
+            )
+            pairing, _, _, _ = PairingService(db)._format_items_for_prompt(shirt, [trousers])
+            for value in evidence.values():
+                self.assertIn(value, recommendation)
+                self.assertIn(value, pairing)
+            shirt.brand = "b" * 100
+            shirt.notes = "n" * 2000
+            shirt.planning_review = dict.fromkeys(
+                (
+                    "condition",
+                    "fit",
+                    "comfort",
+                    "decision",
+                    "composition",
+                    "construction",
+                    "care",
+                    "measurements",
+                    "defects",
+                    "notes",
+                ),
+                "e" * 2000,
+            )
+            self.assertLessEqual(len(prompt_evidence(shirt)), 1200)
+        new_evidence = {
+            "composition": "Cotton/linen blend",
+            "construction": "Seller reports flat felled seams",
+            "care": "Machine wash cold",
+            "measurements": "Shoulders 48 cm",
+        }
+        candidate = await self.client.post(
+            "/api/v1/planning/candidates",
+            json={
+                "name": "Oxford L",
+                "item_type": "shirt",
+                "replaces_item_id": str(self.shirt.id),
+                **new_evidence,
+            },
+        )
+        self.assertEqual(candidate.status_code, 201, candidate.text)
+        comparison = (
+            await self.client.get(
+                f"/api/v1/planning/candidates/{candidate.json()['id']}/comparison"
+            )
+        ).json()
+        for field in evidence:
+            self.assertIn(
+                f"Recorded {field}: old garment: {evidence[field]}; candidate: {new_evidence[field]}",
+                comparison["reasons"],
+            )
+        self.assertIn("price is not recorded", comparison["unknowns"])
+
+    async def test_cross_user_candidate_reference_and_authentication(self):
+        created = await self.client.post(
+            "/api/v1/planning/candidates",
+            json={"name": "X", "item_type": "shirt", "replaces_item_id": str(self.other.id)},
+        )
+        self.assertEqual(created.status_code, 404)
+        own = await self.client.post(
+            "/api/v1/planning/candidates", json={"name": "X", "item_type": "shirt"}
+        )
+        cid = own.json()["id"]
+        app.dependency_overrides[get_current_user] = lambda: User(id=self.other_id)
+        self.assertEqual(
+            (await self.client.get(f"/api/v1/planning/candidates/{cid}/comparison")).status_code,
+            404,
+        )
+        self.assertEqual(
+            (await self.client.delete(f"/api/v1/planning/candidates/{cid}?version=1")).status_code,
+            404,
+        )
+        del app.dependency_overrides[get_current_user]
+        self.assertIn((await self.client.get("/api/v1/planning/audit")).status_code, (401, 403))
+
