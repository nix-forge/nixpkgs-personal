--- /dev/null
+++ b/backend/app/services/ai_provider.py
@@ -0,0 +1,61 @@
+"""Provider discovery and credentials scoped to the configured endpoint."""
+
+import asyncio
+import httpx
+import os
+from pathlib import Path
+
+
+def provider_headers(url, configured_url, api_key):
+    headers = {"Content-Type": "application/json"}
+    codex_url = os.environ.get("WARDROWBE_CODEX_URL", "").rstrip("/")
+    if codex_url and url.rstrip("/") == codex_url:
+        token_file = os.environ.get("WARDROWBE_CODEX_TOKEN_FILE", "")
+        if token_file:
+            headers["Authorization"] = f"Bearer {Path(token_file).read_text(encoding='utf-8').strip()}"
+    elif api_key and url.rstrip("/") == configured_url.rstrip("/"):
+        headers["Authorization"] = f"Bearer {api_key}"
+    return headers
+
+
+async def discover_models(client, url, configured_url, api_key):
+    response = await client.get(
+        f"{url}/models", headers=provider_headers(url, configured_url, api_key)
+    )
+    if response.status_code != 200:
+        return {"status": "error", "error": f"Model discovery returned HTTP {response.status_code}"}
+    names = sorted({item["id"] for item in response.json()["data"] if isinstance(item.get("id"), str)})
+    # OpenAI compatible catalogs do not standardize vision capabilities.
+    # Offer the catalog in both selectors unless Ollama can identify capabilities.
+    vision, text = names, names
+    if url.endswith("/v1"):
+        native = url[:-3]
+        try:
+            tags = await client.get(f"{native}/api/tags", timeout=2)
+            is_ollama = tags.status_code == 200 and isinstance(tags.json().get("models"), list)
+        except (httpx.RequestError, ValueError, AttributeError):
+            is_ollama = False
+        if is_ollama:
+            slots = asyncio.Semaphore(4)
+
+            async def capabilities(name):
+                async with slots:
+                    try:
+                        result = await client.post(f"{native}/api/show", json={"model": name}, timeout=2)
+                        if result.status_code != 200:
+                            return name, None
+                        return name, result.json().get("capabilities")
+                    except (httpx.RequestError, ValueError, AttributeError):
+                        return name, None
+
+            try:
+                available = await asyncio.wait_for(
+                    asyncio.gather(*(capabilities(name) for name in names[:100])), timeout=5
+                )
+            except TimeoutError:
+                available = []
+            known = {name: caps for name, caps in available if isinstance(caps, list)}
+            vision = [name for name in names if name not in known or "vision" in known[name]]
+            text = [name for name in names if name not in known or "completion" in known[name]]
+    return {"status": "connected", "available_models": names,
+            "vision_models": vision, "text_models": text}
