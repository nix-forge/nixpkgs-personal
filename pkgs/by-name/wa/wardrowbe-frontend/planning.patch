+'use client';
+import { useState, useEffect } from 'react';
+import { useQuery } from '@tanstack/react-query';
+import { planning } from '@/lib/planning';
+import { GarmentChooser } from '@/components/planning-chooser';
+import { GarmentReview } from '@/components/planning-review';
+import {
+  PlanningCollection,
+  CoverageRows,
+  Coverage,
+} from '@/components/planning-collection';
+import { Button } from '@/components/ui/button';
+type Finding = {
+  item_id: string;
+  name: string;
+  reasons: string[];
+  wear_count?: number;
+  coverage_gaps?: string[];
+  review?: { priority?: string };
+};
+type Audit = {
+  coverage: Coverage[];
+  unreviewed: Finding[];
+  repairs: Finding[];
+  fit_problems: Finding[];
+  replacements: Finding[];
+};
+export default function PlanningPage() {
+  const [tab, setTab] = useState('review');
+  const [item, setItem] = useState('');
+  useEffect(() => {
+    const id = new URLSearchParams(window.location.search).get('item');
+    if (id && /^[0-9a-f-]{36}$/i.test(id)) setItem(id);
+  }, []);
+  const audit = useQuery({
+    queryKey: ['planning', 'audit'],
+    queryFn: () => planning.get<Audit>('audit'),
+    enabled: tab === 'audit',
+  });
+  return (
+    <div className="space-y-6 max-w-5xl mx-auto">
+      <header>
+        <h1 className="text-2xl font-bold">Wardrobe planning</h1>
+        <p className="text-muted-foreground">
+          Review individual garments, plan repairs and replacements, and compare
+          purchases against your actual needs.
+        </p>
+      </header>
+      <nav aria-label="Planning sections" className="flex flex-wrap gap-2">
+        {[
+          ['review', 'Garment reviews'],
+          ['audit', 'Wardrobe audit'],
+          ['requirements', 'Lifestyle needs'],
+          ['candidates', 'Shopping candidates'],
+        ].map(([key, label]) => (
+          <Button
+            key={key}
+            variant={tab === key ? 'default' : 'outline'}
+            aria-current={tab === key ? 'page' : undefined}
+            onClick={() => setTab(key)}
+          >
+            {label}
+          </Button>
+        ))}
+      </nav>
+      {tab === 'review' && (
+        <section className="space-y-4">
+          <h2 className="text-xl font-semibold">Select a garment to inspect</h2>
+          <GarmentChooser value={item} onChange={setItem} />
+          {item ? (
+            <GarmentReview key={item} itemId={item} />
+          ) : (
+            <p>
+              Select a garment to record condition, fit, evidence and your
+              decision.
+            </p>
+          )}
+        </section>
+      )}
+      {(tab === 'requirements' || tab === 'candidates') && (
+        <PlanningCollection key={tab} kind={tab} />
+      )}
+      {tab === 'audit' && (
+        <section className="space-y-4">
+          <h2 className="text-xl font-semibold">Your wardrobe audit</h2>
+          <p className="text-muted-foreground">
+            Results follow your declared needs and confirmed evidence.
+            Unreviewed garments require inspection.
+          </p>
+          <Button
+            variant="outline"
+            disabled={audit.isFetching}
+            onClick={() => audit.refetch()}
+          >
+            Refresh audit
+          </Button>
+          {audit.isPending ? (
+            <p role="status">Analyzing wardrobe…</p>
+          ) : audit.isError ? (
+            <p role="alert">Unable to load audit. Try refreshing.</p>
+          ) : (
+            <>
+              <h3 className="font-semibold">Coverage of your needs</h3>
+              {audit.data.coverage.length ? (
+                <CoverageRows rows={audit.data.coverage} />
+              ) : (
+                <p>Add lifestyle needs to calculate coverage.</p>
+              )}
+              {(
+                [
+                  ['unreviewed', 'Needs inspection'],
+                  ['repairs', 'Repair or alteration'],
+                  ['fit_problems', 'Fit and comfort problems'],
+                  ['replacements', 'Replacement priorities'],
+                ] as const
+              ).map(([key, label]) => (
+                <section key={key}>
+                  <h3 className="font-semibold my-2">{label}</h3>
+                  {audit.data[key].length ? (
+                    <ul className="space-y-2">
+                      {audit.data[key].map((row) => (
+                        <li key={row.item_id} className="border rounded p-3">
+                          <Button
+                            variant="link"
+                            onClick={() => {
+                              setItem(row.item_id);
+                              setTab('review');
+                            }}
+                          >
+                            {row.name || 'Review garment'}
+                          </Button>
+                          <p className="text-sm">
+                            Priority: {row.review?.priority || 'normal'}
+                            {row.wear_count !== undefined
+                              ? ` · Worn ${row.wear_count} times`
+                              : ''}
+                          </p>
+                          {!!row.coverage_gaps?.length && (
+                            <p className="text-sm">
+                              Related gaps: {row.coverage_gaps.join(', ')}
+                            </p>
+                          )}
+                          <ul className="list-disc pl-5">
+                            {row.reasons.map((reason, i) => (
+                              <li key={i}>{reason}</li>
+                            ))}
+                          </ul>
+                        </li>
+                      ))}
+                    </ul>
+                  ) : (
+                    <p className="text-sm text-muted-foreground">
+                      No garments in this group.
+                    </p>
+                  )}
+                </section>
+              ))}
+            </>
+          )}
+        </section>
+      )}
+    </div>
+  );
+}
