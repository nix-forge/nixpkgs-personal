@@ -0,0 +1,102 @@
+'use client';
+import { useState, useEffect } from 'react';
+import { useItems } from '@/lib/hooks/use-items';
+import { Button } from './ui/button';
+export function GarmentChooser({
+  value,
+  onChange,
+  exclude,
+}: {
+  value: string;
+  onChange: (id: string) => void;
+  exclude?: string;
+}) {
+  const [search, setSearch] = useState('');
+  const [debounced, setDebounced] = useState('');
+  useEffect(() => {
+    const timer = setTimeout(() => {
+      setDebounced(search);
+      setPage(1);
+    }, 300);
+    return () => clearTimeout(timer);
+  }, [search]);
+  const [page, setPage] = useState(1);
+  const query = useItems({ search: debounced || undefined }, page, 12);
+  return (
+    <div className="space-y-2">
+      <label className="block">
+        Search your garments
+        <input
+          type="search"
+          className="block w-full rounded border bg-background p-2"
+          value={search}
+          onChange={(e) => {
+            setSearch(e.target.value);
+            setPage(1);
+          }}
+        />
+      </label>
+      {query.isPending ? (
+        <p role="status">Loading garments…</p>
+      ) : query.isError ? (
+        <p role="alert">
+          Unable to load garments.{' '}
+          <Button onClick={() => query.refetch()}>Retry</Button>
+        </p>
+      ) : (
+        <>
+          <div className="grid gap-2 sm:grid-cols-2">
+            {query.data?.items
+              .filter((item) => item.id !== exclude)
+              .map((item) => (
+                <button
+                  type="button"
+                  key={item.id}
+                  aria-pressed={value === item.id}
+                  className={`rounded border p-3 text-left ${value === item.id ? 'border-primary bg-accent' : ''}`}
+                  onClick={() => onChange(item.id)}
+                >
+                  {(item.thumbnail_url || item.image_url) && (
+                    <img
+                      src={item.thumbnail_url || item.image_url}
+                      alt=""
+                      className="h-16 w-16 object-contain rounded mb-2"
+                    />
+                  )}
+                  {item.name || item.type}
+                  {item.brand ? ` · ${item.brand}` : ''}
+                </button>
+              ))}
+          </div>
+          {query.data?.items.length === 0 && (
+            <p>No garments match this search.</p>
+          )}
+          <div className="flex gap-2">
+            <Button
+              type="button"
+              variant="outline"
+              disabled={page === 1 || query.isFetching}
+              onClick={() => setPage(page - 1)}
+            >
+              Previous
+            </Button>
+            <span className="self-center">Page {page}</span>
+            <Button
+              type="button"
+              variant="outline"
+              disabled={!query.data?.has_more || query.isFetching}
+              onClick={() => setPage(page + 1)}
+            >
+              Next
+            </Button>
+          </div>
+        </>
+      )}
+      {value && (
+        <Button type="button" variant="ghost" onClick={() => onChange('')}>
+          Clear selected garment
+        </Button>
+      )}
+    </div>
+  );
+}
