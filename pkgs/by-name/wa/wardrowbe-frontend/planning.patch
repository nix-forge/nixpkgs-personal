--- /dev/null
+++ b/lib/planning.ts
@@ -0,0 +1,54 @@
+import { api } from '@/lib/api';
+export type RecordData = {
+  id?: string;
+  version?: number;
+  [key: string]: unknown;
+};
+export const planning = {
+  get: <T>(path: string) => api.get<T>(`/planning/${path}`),
+  save: <T>(path: string, data: RecordData) =>
+    data.id
+      ? api.put<T>(
+          `/planning/${path}/${data.id}`,
+          Object.fromEntries(
+            Object.entries(data).filter(([key]) => key !== 'id'),
+          ),
+        )
+      : api.post<T>(`/planning/${path}`, data),
+};
+export function planningError(error: unknown): string {
+  if (
+    error &&
+    typeof error === 'object' &&
+    'status' in error &&
+    error.status === 409 &&
+    'data' in error
+  ) {
+    const detail = (error.data as { detail?: unknown })?.detail;
+    if (typeof detail === 'string' && !/changed|reload/i.test(detail))
+      return detail;
+  }
+  if (
+    error &&
+    typeof error === 'object' &&
+    'status' in error &&
+    error.status === 409
+  )
+    return 'This record changed in another session. Your input is preserved. Reload the latest record before saving again.';
+  if (error && typeof error === 'object' && 'data' in error) {
+    const data = error.data as { detail?: { loc?: string[]; msg?: string }[] };
+    if (Array.isArray(data?.detail))
+      return data.detail
+        .map(
+          (issue) =>
+            `${issue.loc?.slice(1).join('.') || 'Input'}: ${issue.msg || 'invalid value'}`,
+        )
+        .join('; ');
+  }
+  return error instanceof Error
+    ? error.message
+    : 'Unable to save. Your input is preserved.';
+}
+export function listValue(value: unknown): string {
+  return Array.isArray(value) ? value.join(', ') : String(value ?? '');
+}
