+'use client';
+import { useState } from 'react';
+import { useQuery, useQueryClient } from '@tanstack/react-query';
+import { api } from '@/lib/api';
+import { planning, RecordData, planningError } from '@/lib/planning';
+import { PlanningForm, Field } from './planning-form';
+import { GarmentChooser } from './planning-chooser';
+import { Button } from './ui/button';
+const common: Field[] = [
+  { key: 'name', label: 'Name', required: true },
+  {
+    key: 'item_type',
+    label: 'Garment type',
+    required: true,
+    hint: 'Use the same type as your inventory, for example shirt, t-shirt, pants or jeans.',
+  },
+  {
+    key: 'colors',
+    label: 'Colors',
+    kind: 'list',
+    hint: 'Comma-separated; leave blank for any.',
+  },
+  { key: 'styles', label: 'Styles', kind: 'list' },
+  { key: 'currency', label: 'Currency code', required: true },
+];
+const needs: Field[] = [
+  ...common,
+  { key: 'occasion', label: 'Activity or occasion' },
+  { key: 'season', label: 'Season' },
+  {
+    key: 'climate',
+    label: 'Climate',
+    hint: 'Match your confirmed garment suitability, for example cold or warm.',
+  },
+  {
+    key: 'target_quantity',
+    label: 'Minimum garments wanted',
+    kind: 'number',
+    max: 1000,
+  },
+  { key: 'weekly_uses', label: 'Uses per week', kind: 'number', max: 100 },
+  {
+    key: 'laundry_days',
+    label: 'Days between laundry',
+    kind: 'number',
+    min: 1,
+    max: 90,
+  },
+  {
+    key: 'wears_between_washes',
+    label: 'Wears between washes',
+    kind: 'number',
+    min: 1,
+    max: 100,
+  },
+  { key: 'budget', label: 'Purchase budget', kind: 'money' },
+];
+const products: Field[] = [
+  ...common,
+  { key: 'suitable_occasions', label: 'Suitable activities', kind: 'list' },
+  { key: 'suitable_climates', label: 'Suitable climates', kind: 'list' },
+  { key: 'url', label: 'Exact product URL', kind: 'url' },
+  { key: 'size', label: 'Size' },
+  { key: 'composition', label: 'Listed composition' },
+  {
+    key: 'construction',
+    label: 'Product construction evidence',
+    kind: 'textarea',
+  },
+  { key: 'care', label: 'Product care instructions', kind: 'textarea' },
+  { key: 'measurements', label: 'Measurements with units' },
+  { key: 'return_policy', label: 'Return policy', kind: 'textarea' },
+  { key: 'seasons', label: 'Seasons', kind: 'list' },
+  { key: 'formality', label: 'Formality' },
+  { key: 'price', label: 'Price', kind: 'money' },
+  { key: 'notes', label: 'Product evidence and notes', kind: 'textarea' },
+];
+export type Coverage = {
+  requirement_id: string;
+  name: string;
+  required: number;
+  available: number;
+  missing: number;
+  unknowns: string[];
+  possible_item_ids?: string[];
+};
+export function CoverageRows({ rows }: { rows: Coverage[] }) {
+  return (
+    <ul className="space-y-2">
+      {rows.map((row) => (
+        <li key={row.requirement_id} className="rounded border p-3">
+          <strong>{row.name}</strong>
+          <p>
+            {row.available} available / {row.required} needed. {row.missing}{' '}
+            missing.
+          </p>
+          {!!row.possible_item_ids?.length && (
+            <p>
+              {row.possible_item_ids.length} additional garment(s) need
+              suitability confirmation.
+            </p>
+          )}
+          {row.unknowns.map((v, i) => (
+            <p className="text-sm text-muted-foreground" key={i}>
+              Unknown: {v}
+            </p>
+          ))}
+        </li>
+      ))}
+    </ul>
+  );
+}
+type Comparison = {
+  reasons: string[];
+  unknowns: string[];
+  duplicates: { item_id: string; name: string }[];
+  compatible_items: { item_id: string; name: string }[];
+  coverage: Coverage[];
+  meets_budget: boolean | null;
+  coverage_gain?: number;
+  coverage_before?: Coverage;
+  coverage_after?: Coverage;
+};
+function CandidateComparison({ id }: { id: string }) {
+  const q = useQuery({
+    queryKey: ['planning', 'comparison', id],
+    queryFn: () => planning.get<Comparison>(`candidates/${id}/comparison`),
+  });
+  if (q.isPending) return <p role="status">Comparing candidate…</p>;
+  if (q.isError)
+    return (
+      <p role="alert">
+        Unable to compare. <Button onClick={() => q.refetch()}>Retry</Button>
+      </p>
+    );
+  return (
+    <div className="space-y-3 border rounded p-4">
+      <h3 className="font-semibold">Purchase comparison</h3>
+      <p>
+        Budget:{' '}
+        {q.data.meets_budget === null
+          ? 'unknown or currencies differ'
+          : q.data.meets_budget
+            ? 'within budget'
+            : 'over budget'}
+      </p>
+      <ul className="list-disc pl-5">
+        {q.data.reasons.map((v, i) => (
+          <li key={i}>{v}</li>
+        ))}
+      </ul>
+      <h4 className="font-medium">Evidence still needed</h4>
+      {q.data.unknowns.length ? (
+        <ul className="list-disc pl-5">
+          {q.data.unknowns.map((v, i) => (
+            <li key={i}>{v}</li>
+          ))}
+        </ul>
+      ) : (
+        <p>No additional unknowns reported.</p>
+      )}
+      <h4 className="font-medium">Similar owned garments</h4>
+      <p>{q.data.duplicates.map((v) => v.name).join(', ') || 'None found.'}</p>
+      <h4 className="font-medium">Compatible owned garments</h4>
+      <p>
+        {q.data.compatible_items.map((v) => v.name).join(', ') || 'None found.'}
+      </p>
+      <CoverageRows rows={q.data.coverage} />
+      {q.data.coverage_gain !== undefined && (
+        <p>
+          Additional coverage from this purchase: {q.data.coverage_gain}{' '}
+          garment(s).
+        </p>
+      )}
+      {q.data.coverage_before && (
+        <div>
+          <h4>Before purchase</h4>
+          <CoverageRows rows={[q.data.coverage_before]} />
+        </div>
+      )}
+      {q.data.coverage_after && (
+        <div>
+          <h4>After purchase</h4>
+          <CoverageRows rows={[q.data.coverage_after]} />
+        </div>
+      )}
+      <p className="text-sm text-muted-foreground">
+        Attribute matches are suggestions. Confirm fit, construction and comfort
+        before buying. Product links are not fetched by the server.
+      </p>
+    </div>
+  );
+}
+export function PlanningCollection({
+  kind,
+}: {
+  kind: 'requirements' | 'candidates';
+}) {
+  const client = useQueryClient();
+  const [offset, setOffset] = useState(0);
+  const [needOffset, setNeedOffset] = useState(0);
+  const [editing, setEditing] = useState<RecordData | null>(null);
+  const [comparison, setComparison] = useState('');
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState(false);
+  const q = useQuery({
+    queryKey: ['planning', kind, offset],
+    queryFn: () =>
+      planning.get<{ items: RecordData[]; total: number }>(
+        `${kind}?limit=20&offset=${offset}`,
+      ),
+  });
+  const requirements = useQuery({
+    queryKey: ['planning', 'requirement-options', needOffset],
+    queryFn: () =>
+      planning.get<{ items: RecordData[]; total: number }>(
+        `requirements?limit=100&offset=${needOffset}`,
+      ),
+    enabled: kind === 'candidates',
+  });
+  async function remove(row: RecordData) {
+    if (!window.confirm(`Delete ${row.name}?`)) return;
+    setBusy(true);
+    setError('');
+    try {
+      await api.delete(`/planning/${kind}/${row.id}?version=${row.version}`);
+      await client.invalidateQueries({ queryKey: ['planning'] });
+      if (editing?.id === row.id) setEditing(null);
+    } catch (e) {
+      setError(planningError(e));
+    } finally {
+      setBusy(false);
+    }
+  }
+  const defaults =
+    kind === 'requirements'
+      ? {
+          name: '',
+          item_type: '',
+          occasion: '',
+          season: '',
+          climate: '',
+          colors: [],
+          styles: [],
+          target_quantity: 1,
+          weekly_uses: 1,
+          laundry_days: 7,
+          wears_between_washes: 1,
+          budget: null,
+          currency: 'USD',
+        }
+      : {
+          suitable_occasions: [],
+          suitable_climates: [],
+          name: '',
+          item_type: '',
+          url: '',
+          size: '',
+          composition: '',
+          construction: '',
+          care: '',
+          measurements: '',
+          return_policy: '',
+          colors: [],
+          styles: [],
+          seasons: [],
+          formality: '',
+          price: null,
+          currency: 'USD',
+          requirement_id: null,
+          replaces_item_id: null,
+          notes: '',
+        };
+  return (
+    <section className="space-y-4">
+      <h2 className="text-xl font-semibold">
+        {kind === 'requirements'
+          ? 'Lifestyle and laundry needs'
+          : 'Exact shopping candidates'}
+      </h2>
+      <p className="text-sm text-muted-foreground">
+        {kind === 'requirements'
+          ? 'Set your own minimums and laundry routine. Coverage counts usable garments and reports missing evidence.'
+          : 'Record a specific product, size and evidence. Compare it with your needs and existing clothes before buying.'}
+      </p>
+      <Button disabled={busy} onClick={() => setEditing(defaults)}>
+        Add {kind === 'requirements' ? 'need' : 'candidate'}
+      </Button>
+      {q.isPending ? (
+        <p role="status">Loading…</p>
+      ) : q.isError ? (
+        <p role="alert">
+          Unable to load records.{' '}
+          <Button onClick={() => q.refetch()}>Retry</Button>
+        </p>
+      ) : (
+        <>
+          <ul className="space-y-2">
+            {q.data.items.map((row) => (
+              <li
+                className="flex flex-wrap gap-2 items-center border rounded p-3"
+                key={String(row.id)}
+              >
+                <span className="flex-1 min-w-32">
+                  {String(row.name)}
+                  {typeof row.url === 'string' &&
+                    /^https?:\/\//i.test(row.url) && (
+                      <a
+                        className="block text-primary underline text-sm"
+                        href={row.url}
+                        target="_blank"
+                        rel="noreferrer noopener"
+                      >
+                        View exact product
+                      </a>
+                    )}
+                </span>
+                <Button variant="outline" onClick={() => setEditing(row)}>
+                  Edit {String(row.name)}
+                </Button>
+                {kind === 'candidates' && (
+                  <Button
+                    variant="outline"
+                    onClick={() => setComparison(String(row.id))}
+                  >
+                    Compare
+                  </Button>
+                )}
+                <Button
+                  variant="destructive"
+                  disabled={busy}
+                  onClick={() => remove(row)}
+                >
+                  Delete
+                </Button>
+              </li>
+            ))}
+          </ul>
+          {q.data.total === 0 && <p>No records yet.</p>}
+          <div className="flex gap-2">
+            <Button
+              disabled={offset === 0}
+              onClick={() => setOffset(offset - 20)}
+            >
+              Previous
+            </Button>
+            <span>
+              {offset + 1}–{Math.min(offset + 20, q.data.total)} of{' '}
+              {q.data.total}
+            </span>
+            <Button
+              disabled={offset + 20 >= q.data.total}
+              onClick={() => setOffset(offset + 20)}
+            >
+              Next
+            </Button>
+          </div>
+        </>
+      )}
+      {error && (
+        <p role="alert" className="text-destructive">
+          {error}
+        </p>
+      )}
+      {editing && (
+        <>
+          <PlanningForm
+            key={`${editing.id || 'new'}-${editing.version || 0}`}
+            initial={{ ...defaults, ...editing }}
+            extraValues={
+              kind === 'candidates'
+                ? {
+                    requirement_id: editing.requirement_id,
+                    replaces_item_id: editing.replaces_item_id,
+                  }
+                : undefined
+            }
+            title={editing.id ? 'Edit record' : 'New record'}
+            fields={kind === 'requirements' ? needs : products}
+            onSave={async (data) => {
+              await planning.save(kind, data);
+              await client.invalidateQueries({ queryKey: ['planning'] });
+              setEditing(null);
+            }}
+          >
+            {kind === 'candidates' && (
+              <div className="space-y-3">
+                <label className="block">
+                  Related wardrobe need
+                  <select
+                    className="block border rounded bg-background p-2 w-full"
+                    value={String(editing.requirement_id || '')}
+                    onChange={(e) =>
+                      setEditing({
+                        ...editing,
+                        requirement_id: e.target.value || null,
+                      })
+                    }
+                  >
+                    <option value="">None</option>
+                    {Boolean(editing.requirement_id) &&
+                      !requirements.data?.items.some(
+                        (r) => r.id === editing.requirement_id,
+                      ) && (
+                        <option value={String(editing.requirement_id)}>
+                          Previously selected need
+                        </option>
+                      )}
+                    {requirements.data?.items.map((r) => (
+                      <option key={String(r.id)} value={String(r.id)}>
+                        {String(r.name)}
+                      </option>
+                    ))}
+                  </select>
+                </label>
+                <div className="flex gap-2">
+                  <Button
+                    type="button"
+                    variant="outline"
+                    disabled={needOffset === 0 || requirements.isFetching}
+                    onClick={() => setNeedOffset(needOffset - 100)}
+                  >
+                    Previous needs
+                  </Button>
+                  <Button
+                    type="button"
+                    variant="outline"
+                    disabled={
+                      !requirements.data ||
+                      needOffset + 100 >= requirements.data.total ||
+                      requirements.isFetching
+                    }
+                    onClick={() => setNeedOffset(needOffset + 100)}
+                  >
+                    More needs
+                  </Button>
+                </div>
+                {requirements.isError && (
+                  <p role="alert">
+                    Unable to load needs.{' '}
+                    <Button
+                      type="button"
+                      onClick={() => requirements.refetch()}
+                    >
+                      Retry
+                    </Button>
+                  </p>
+                )}
+                <p>Garment this product would replace</p>
+                <GarmentChooser
+                  value={String(editing.replaces_item_id || '')}
+                  onChange={(id) =>
+                    setEditing({ ...editing, replaces_item_id: id || null })
+                  }
+                />
+              </div>
+            )}
+          </PlanningForm>
+          <div className="flex gap-2">
+            <Button variant="outline" onClick={() => setEditing(null)}>
+              Cancel edit
+            </Button>
+            {editing.id && (
+              <Button
+                variant="outline"
+                onClick={async () => {
+                  if (
+                    !window.confirm(
+                      'Reloading discards unsaved edits. Continue?',
+                    )
+                  )
+                    return;
+                  try {
+                    const latest = await q.refetch();
+                    const record = latest.data?.items.find(
+                      (r) => r.id === editing.id,
+                    );
+                    if (record) setEditing(record);
+                    else
+                      setError('Record unavailable. It may have been deleted.');
+                  } catch (e) {
+                    setError(planningError(e));
+                  }
+                }}
+              >
+                Reload latest record
+              </Button>
+            )}
+          </div>
+        </>
+      )}
+      {comparison && <CandidateComparison id={comparison} />}
+    </section>
+  );
+}
diff --git a/components/planning-form.tsx b/components/planning-form.tsx
new file mode 100644
index 000000000000..f4f61494b659
--- /dev/null
+++ b/components/planning-form.tsx
@@ -0,0 +1,194 @@
+'use client';
+import { useState, useEffect } from 'react';
+import { Button } from '@/components/ui/button';
+import { RecordData, listValue, planningError } from '@/lib/planning';
+export type Field = {
+  key: string;
+  label: string;
+  kind?: 'number' | 'money' | 'list' | 'checkbox' | 'textarea' | 'url';
+  options?: string[];
+  min?: number;
+  max?: number;
+  maxLength?: number;
+  required?: boolean;
+  hint?: string;
+};
+export function PlanningForm({
+  initial,
+  fields,
+  onSave,
+  title,
+  children,
+  extraValues,
+  appendNotes,
+  onDirtyChange,
+  onPendingChange,
+  onNotesChange,
+  externalDisabled = false,
+}: {
+  initial: RecordData;
+  fields: Field[];
+  onSave: (data: RecordData) => Promise<unknown>;
+  title: string;
+  children?: React.ReactNode;
+  extraValues?: RecordData;
+  appendNotes?: { text: string; sequence: number };
+  onDirtyChange?: (dirty: boolean) => void;
+  onPendingChange?: (pending: boolean) => void;
+  onNotesChange?: (notes: string) => void;
+  externalDisabled?: boolean;
+}) {
+  const [values, setValues] = useState(initial);
+  useEffect(() => {
+    if (appendNotes)
+      setValues((current) => ({
+        ...current,
+        notes: [current.notes, appendNotes.text].filter(Boolean).join('\n\n'),
+      }));
+  }, [appendNotes]);
+  useEffect(() => {
+    onNotesChange?.(String(values.notes || ''));
+  }, [values.notes, onNotesChange]);
+  const [pending, setPending] = useState(false);
+  useEffect(() => {
+    onDirtyChange?.(JSON.stringify(values) !== JSON.stringify(initial));
+  }, [values, initial, onDirtyChange]);
+  useEffect(() => {
+    onPendingChange?.(pending);
+  }, [pending, onPendingChange]);
+  const [error, setError] = useState('');
+  const [saved, setSaved] = useState(false);
+  async function submit(event: React.FormEvent) {
+    event.preventDefault();
+    if (pending || externalDisabled) return;
+    setPending(true);
+    setError('');
+    setSaved(false);
+    try {
+      const payload: RecordData = Object.fromEntries(
+        fields.map((f) => [
+          f.key,
+          f.kind === 'list'
+            ? listValue(values[f.key])
+                .split(',')
+                .map((v) => v.trim())
+                .filter(Boolean)
+            : values[f.key],
+        ]),
+      );
+      if (payload.url === '') payload.url = null;
+      if (values.id) payload.id = values.id;
+      if (values.version !== undefined) payload.version = values.version;
+      await onSave({ ...payload, ...extraValues });
+      setSaved(true);
+    } catch (e) {
+      setError(planningError(e));
+    } finally {
+      setPending(false);
+    }
+  }
+  return (
+    <form onSubmit={submit} className="space-y-4 rounded-lg border p-4">
+      <h3 className="font-semibold text-lg">{title}</h3>
+      <fieldset
+        disabled={pending || externalDisabled}
+        className="grid gap-4 sm:grid-cols-2"
+      >
+        {fields.map((field) => (
+          <label
+            key={field.key}
+            className={`flex flex-col gap-1 text-sm ${field.kind === 'textarea' ? 'sm:col-span-2' : ''}`}
+          >
+            <span>
+              {field.label}
+              {field.required ? ' *' : ''}
+            </span>
+            {field.options ? (
+              <select
+                className="rounded-md border bg-background p-2"
+                value={String(values[field.key] ?? '')}
+                onChange={(e) =>
+                  setValues({ ...values, [field.key]: e.target.value })
+                }
+              >
+                {field.options.map((v) => (
+                  <option key={v} value={v}>
+                    {v}
+                  </option>
+                ))}
+              </select>
+            ) : field.kind === 'checkbox' ? (
+              <input
+                type="checkbox"
+                checked={Boolean(values[field.key])}
+                onChange={(e) =>
+                  setValues({ ...values, [field.key]: e.target.checked })
+                }
+              />
+            ) : field.kind === 'textarea' ? (
+              <textarea
+                className="rounded-md border bg-background p-2"
+                rows={3}
+                maxLength={2000}
+                value={listValue(values[field.key])}
+                onChange={(e) =>
+                  setValues({ ...values, [field.key]: e.target.value })
+                }
+              />
+            ) : (
+              <input
+                className="rounded-md border bg-background p-2"
+                type={
+                  field.kind === 'number' || field.kind === 'money'
+                    ? 'number'
+                    : field.kind === 'url'
+                      ? 'url'
+                      : 'text'
+                }
+                min={field.min ?? 0}
+                max={field.max}
+                step={
+                  field.kind === 'money'
+                    ? '0.01'
+                    : field.kind === 'number'
+                      ? '1'
+                      : undefined
+                }
+                required={field.required}
+                maxLength={
+                  field.maxLength ??
+                  (field.kind === 'url' || field.kind === 'list' ? 2000 : 100)
+                }
+                value={listValue(values[field.key])}
+                onChange={(e) =>
+                  setValues({
+                    ...values,
+                    [field.key]:
+                      field.kind === 'number'
+                        ? Number(e.target.value)
+                        : field.kind === 'money'
+                          ? e.target.value || null
+                          : e.target.value,
+                  })
+                }
+              />
+            )}
+            {field.hint && (
+              <span className="text-muted-foreground">{field.hint}</span>
+            )}
+          </label>
+        ))}
+      </fieldset>
+      <fieldset disabled={pending || externalDisabled}>{children}</fieldset>
+      {error && (
+        <p role="alert" className="text-destructive">
+          {error}
+        </p>
+      )}
+      {saved && <p role="status">Saved.</p>}
+      <Button type="submit" disabled={pending || externalDisabled}>
+        {pending ? 'Saving…' : 'Save'}
+      </Button>
+    </form>
+  );
+}
diff --git a/components/planning-review.tsx b/components/planning-review.tsx
new file mode 100644
index 000000000000..dd625978d89a
--- /dev/null
+++ b/components/planning-review.tsx
@@ -0,0 +1,454 @@
+'use client';
+import { useState, useEffect } from 'react';
+import { useQuery, useQueryClient } from '@tanstack/react-query';
+import { api } from '@/lib/api';
+import { RecordData, planning, planningError } from '@/lib/planning';
+import { PlanningForm, Field } from './planning-form';
+import { Button } from './ui/button';
+import { GarmentChooser } from './planning-chooser';
+const defaults = {
+  condition: 'unknown',
+  fit: 'unknown',
+  comfort: 'unknown',
+  decision: 'keep',
+  available: true,
+  composition: '',
+  construction: '',
+  defects: '',
+  care: '',
+  measurements: '',
+  notes: '',
+  repair_cost: null,
+  currency: 'USD',
+  priority: 'normal',
+  suitable_occasions: [],
+  suitable_climates: [],
+};
+const fields: Field[] = [
+  {
+    key: 'condition',
+    label: 'Observed condition',
+    options: ['unknown', 'good', 'worn', 'damaged', 'unusable'],
+  },
+  {
+    key: 'fit',
+    label: 'Fit',
+    options: ['unknown', 'good', 'tight', 'loose', 'uncomfortable'],
+  },
+  { key: 'comfort', label: 'Comfort', options: ['unknown', 'good', 'poor'] },
+  {
+    key: 'decision',
+    label: 'Your decision',
+    options: ['keep', 'repair', 'alter', 'replace', 'retire'],
+  },
+  {
+    key: 'priority',
+    label: 'Replacement priority',
+    options: ['low', 'normal', 'high'],
+  },
+  {
+    key: 'suitable_occasions',
+    label: 'Confirmed suitable activities',
+    kind: 'list',
+    hint: 'Comma-separated, such as work, hiking.',
+  },
+  {
+    key: 'suitable_climates',
+    label: 'Confirmed suitable climates',
+    kind: 'list',
+    hint: 'Comma-separated, such as cold, warm.',
+  },
+  {
+    key: 'available',
+    label: 'Available for outfit recommendations',
+    kind: 'checkbox',
+  },
+  { key: 'composition', label: 'Fabric composition from label' },
+  { key: 'measurements', label: 'Measurements with units' },
+  {
+    key: 'construction',
+    label: 'Construction evidence',
+    kind: 'textarea',
+    hint: 'Inspect seams, fabric opacity, buttons and shape after washing.',
+  },
+  { key: 'defects', label: 'Damage or defects', kind: 'textarea' },
+  { key: 'care', label: 'Care instructions' },
+  { key: 'repair_cost', label: 'Estimated repair cost', kind: 'money' },
+  { key: 'currency', label: 'Currency code', required: true },
+  { key: 'notes', label: 'Your confirmed observations', kind: 'textarea' },
+];
+type ReviewData = {
+  version: number;
+  current: RecordData | null;
+  history: RecordData[];
+  history_total?: number;
+  has_more?: boolean;
+};
+export function GarmentReview({ itemId }: { itemId: string }) {
+  const client = useQueryClient();
+  const path = `items/${itemId}/review`;
+  const review = useQuery({
+    queryKey: ['planning', path],
+    queryFn: () => planning.get<ReviewData>(path),
+  });
+  const [snapshot, setSnapshot] = useState<ReviewData | null>(null);
+  const [resetId, setResetId] = useState(0);
+  const [notes, setNotes] = useState('');
+  const [dirty, setDirty] = useState(false);
+  const [formSaving, setFormSaving] = useState(false);
+  const [historyOffset, setHistoryOffset] = useState(0);
+  const historyPage = useQuery({
+    queryKey: ['planning', path, 'history', historyOffset],
+    queryFn: () =>
+      planning.get<ReviewData>(`${path}?limit=50&offset=${historyOffset}`),
+    enabled: historyOffset > 0,
+  });
+  useEffect(() => {
+    if (!snapshot && review.data) setSnapshot(review.data);
+  }, [review.data, snapshot]);
+  const [observations, setObservations] = useState('');
+  const [draft, setDraft] = useState<{
+    observations: string;
+    unknowns: string[];
+    model?: string;
+    observed_at?: string;
+    review_version?: number;
+    scope?: string;
+  } | null>(null);
+  const [successor, setSuccessor] = useState('');
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState('');
+  const [appendNotes, setAppendNotes] = useState<{
+    text: string;
+    sequence: number;
+  }>();
+  async function action(fn: () => Promise<unknown>) {
+    setPending(true);
+    setError('');
+    try {
+      await fn();
+    } catch (e) {
+      setError(planningError(e));
+    } finally {
+      setPending(false);
+    }
+  }
+  if (review.isPending && !snapshot)
+    return <p role="status">Loading garment review…</p>;
+  if (review.isError && !snapshot)
+    return (
+      <div role="alert">
+        Unable to load review.{' '}
+        <Button
+          disabled={formSaving || pending}
+          onClick={async () => {
+            if (
+              dirty &&
+              !window.confirm(
+                'Reloading discards unsaved review edits. Continue?',
+              )
+            )
+              return;
+            const latest = await review.refetch();
+            if (latest.data) {
+              setSnapshot(latest.data);
+              setResetId((value) => value + 1);
+              setAppendNotes(undefined);
+              setDirty(false);
+            }
+          }}
+        >
+          Retry
+        </Button>
+      </div>
+    );
+  if (!snapshot || !review.data)
+    return <p role="status">Loading garment review…</p>;
+  return (
+    <section className="space-y-4">
+      <p className="text-sm text-muted-foreground">
+        Record what you can verify. Age and a photo alone do not establish
+        quality. Unknown evidence stays unknown.
+      </p>
+      <PlanningForm
+        externalDisabled={pending}
+        key={`${itemId}-${snapshot.version}-${resetId}`}
+        onNotesChange={setNotes}
+        onDirtyChange={setDirty}
+        onPendingChange={setFormSaving}
+        appendNotes={appendNotes}
+        title="Confirmed garment review"
+        initial={{
+          ...defaults,
+          ...snapshot.current,
+          version: snapshot.version,
+        }}
+        fields={fields}
+        onSave={async (data) => {
+          const saved = await api.put<ReviewData>(
+            `/planning/${path}`,
+            Object.fromEntries(
+              Object.entries(data).filter(([key]) => key !== 'id'),
+            ),
+          );
+          setSnapshot(
+            saved?.version !== undefined
+              ? saved
+              : (await review.refetch()).data || snapshot,
+          );
+          setDirty(false);
+          setAppendNotes(undefined);
+          await client.invalidateQueries({ queryKey: ['planning'] });
+        }}
+      />
+      {Boolean(review.data.current?.successor_id) && (
+        <p className="text-sm">
+          This garment has an owned replacement linked. Its past reviews remain
+          available below.
+        </p>
+      )}
+      <details className="rounded-lg border p-4">
+        <summary className="cursor-pointer font-semibold">
+          Optional AI observations
+        </summary>
+        <p className="mt-3 text-sm">
+          AI uses only the text you enter here. It does not inspect your garment
+          photos. Confirm physical evidence yourself.
+        </p>
+        <label className="block my-3">
+          Evidence for AI to consider
+          <textarea
+            className="block w-full border rounded bg-background p-2"
+            rows={3}
+            maxLength={2000}
+            value={observations}
+            onChange={(e) => setObservations(e.target.value)}
+          />
+        </label>
+        <Button
+          disabled={pending || formSaving || !observations.trim()}
+          onClick={() =>
+            action(async () => {
+              const result = await api.post<{
+                draft: { observations: string; unknowns: string[] };
+                model?: string;
+                observed_at?: string;
+                review_version?: number;
+                scope?: string;
+              }>(`/planning/items/${itemId}/draft`, { observations });
+              setDraft({
+                ...result.draft,
+                model: result.model,
+                observed_at: result.observed_at,
+                review_version: result.review_version,
+                scope: result.scope,
+              });
+            })
+          }
+        >
+          Request unconfirmed draft
+        </Button>
+        {draft && (
+          <div className="mt-3 space-y-2">
+            <p className="text-sm">
+              Model: {draft.model || 'Configured provider'}
+              {draft.observed_at ? ` · Generated ${draft.observed_at}` : ''}
+            </p>
+            <label className="block">
+              Editable unconfirmed draft
+              <textarea
+                className="block w-full border rounded bg-background p-2"
+                rows={6}
+                maxLength={8000}
+                value={draft.observations}
+                onChange={(event) =>
+                  setDraft({ ...draft, observations: event.target.value })
+                }
+              />
+            </label>
+            <p className="text-sm">
+              Remaining confirmed-note capacity:{' '}
+              {Math.max(0, 2000 - notes.length - (notes.length ? 2 : 0))}{' '}
+              characters.
+            </p>
+            {draft.review_version !== undefined &&
+              draft.review_version !== snapshot.version && (
+                <p role="alert">
+                  This draft was generated for a different review version.
+                  Reload your review and regenerate the draft before appending.
+                </p>
+              )}
+            {notes.length + (notes.length ? 2 : 0) + draft.observations.length >
+              2000 && (
+              <p role="alert">
+                The draft will not fit into your notes. Shorten the editable
+                draft before appending. The full draft is preserved.
+              </p>
+            )}
+            <ul className="list-disc pl-5">
+              {draft.unknowns.map((v, i) => (
+                <li key={i}>Unknown: {v}</li>
+              ))}
+            </ul>
+            <Button
+              disabled={
+                pending ||
+                formSaving ||
+                notes.length +
+                  (notes.length ? 2 : 0) +
+                  draft.observations.length >
+                  2000 ||
+                (draft.review_version !== undefined &&
+                  draft.review_version !== snapshot.version)
+              }
+              onClick={() =>
+                setAppendNotes({
+                  text: draft.observations,
+                  sequence: Date.now(),
+                })
+              }
+            >
+              Append draft to review for my confirmation
+            </Button>
+            <p className="text-sm">
+              Review the appended notes and select Save to confirm them.
+            </p>
+          </div>
+        )}
+      </details>
+      <details className="rounded-lg border p-4">
+        <summary className="cursor-pointer font-semibold">
+          Link an owned replacement
+        </summary>
+        <p className="my-3 text-sm">
+          Add your purchased garment to the wardrobe first. Linking it preserves
+          the old review and retires the old garment.
+        </p>
+        <GarmentChooser
+          value={successor}
+          onChange={setSuccessor}
+          exclude={itemId}
+        />
+        <Button
+          className="mt-3"
+          disabled={pending || formSaving || !successor}
+          onClick={() =>
+            action(async () => {
+              if (
+                dirty &&
+                !window.confirm(
+                  'Retiring this garment will discard your unsaved review edits. Save your review first or confirm discarding them.',
+                )
+              )
+                return;
+              const updated = await api.post<ReviewData>(
+                `/planning/items/${itemId}/replace`,
+                { successor_id: successor, version: snapshot.version },
+              );
+              setSnapshot(updated);
+              setResetId((value) => value + 1);
+              setDirty(false);
+              setAppendNotes(undefined);
+              await client.invalidateQueries({ queryKey: ['planning'] });
+            })
+          }
+        >
+          Confirm replacement and retire old garment
+        </Button>
+      </details>
+      {error && (
+        <p role="alert" className="text-destructive">
+          {error}
+        </p>
+      )}
+      <details className="rounded-lg border p-4">
+        <summary className="cursor-pointer font-semibold">
+          Review history (
+          {review.data.history_total ?? review.data.history.length})
+        </summary>
+        {(historyOffset ? historyPage.data?.history : review.data.history)
+          ?.length === 0 ? (
+          <p>No confirmed reviews yet.</p>
+        ) : (
+          (historyOffset
+            ? historyPage.data?.history || []
+            : review.data.history
+          ).map((entry, i) => (
+            <article className="border-t mt-3 pt-3" key={i}>
+              <p>
+                {String(entry.created_at)} · {String(entry.decision)} ·{' '}
+                {String(entry.condition)}
+              </p>
+              <dl>
+                {fields
+                  .filter(
+                    (f) =>
+                      entry[f.key] !== undefined &&
+                      entry[f.key] !== null &&
+                      entry[f.key] !== '',
+                  )
+                  .map((f) => (
+                    <div key={f.key} className="text-sm">
+                      <dt className="font-medium inline">{f.label}: </dt>
+                      <dd className="inline whitespace-pre-wrap">
+                        {String(entry[f.key])}
+                      </dd>
+                    </div>
+                  ))}
+              </dl>
+            </article>
+          ))
+        )}
+        {historyPage.isFetching && <p role="status">Loading review history…</p>}
+        {historyPage.isError && (
+          <p role="alert">
+            Unable to load history.{' '}
+            <Button onClick={() => historyPage.refetch()}>Retry</Button>
+          </p>
+        )}
+        <div className="flex gap-2">
+          <Button
+            variant="outline"
+            disabled={historyOffset === 0}
+            onClick={() => setHistoryOffset(historyOffset - 50)}
+          >
+            Newer reviews
+          </Button>
+          <Button
+            variant="outline"
+            disabled={
+              !(historyOffset
+                ? historyPage.data?.has_more
+                : review.data.has_more)
+            }
+            onClick={() => setHistoryOffset(historyOffset + 50)}
+          >
+            Older reviews
+          </Button>
+        </div>
+      </details>
+      <Button
+        variant="outline"
+        disabled={formSaving || pending}
+        onClick={async () => {
+          if (
+            dirty &&
+            !window.confirm(
+              'Reloading discards unsaved review edits. Continue?',
+            )
+          )
+            return;
+          const latest = await review.refetch();
+          if (latest.data) {
+            setSnapshot(latest.data);
+            setResetId((value) => value + 1);
+            setAppendNotes(undefined);
+            setDirty(false);
+          }
+        }}
+      >
+        Reload latest review
+      </Button>
+    </section>
+  );
+}
