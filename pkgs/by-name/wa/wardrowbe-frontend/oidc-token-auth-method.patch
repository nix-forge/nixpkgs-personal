+++ b/tests/oidc-logout.test.ts
@@ -0,0 +1,103 @@
+// @vitest-environment node
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+import { getToken } from 'next-auth/jwt';
+import { GET } from '@/app/auth/logout/route';
+import { clearSessionCookies } from '@/lib/session-cookies';
+
+vi.mock('next-auth/jwt', () => ({ getToken: vi.fn() }));
+vi.mock('@/lib/session-cookies', () => ({ clearSessionCookies: vi.fn() }));
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  vi.mocked(getToken).mockResolvedValue(null);
+  for (const name of [
+    'NEXTAUTH_URL', 'FORWARD_AUTH_LOGOUT_URL', 'TINYAUTH_URL',
+    'OIDC_END_SESSION_URL', 'OIDC_CLIENT_ID', 'NEXTAUTH_SECRET',
+  ]) vi.stubEnv(name, undefined);
+});
+
+afterEach(() => vi.unstubAllEnvs());
+
+async function logout() {
+  const request = new NextRequest('https://wardrobe.example/auth/logout');
+  const response = await GET(request);
+  expect(response.status).toBe(302);
+  expect(clearSessionCookies).toHaveBeenCalledExactlyOnceWith(request, response);
+  const location = response.headers.get('location');
+  expect(location).not.toBeNull();
+  if (location === null) throw new Error('Logout did not return a redirect');
+  return { request, target: new URL(location) };
+}
+
+describe('actual logout route', () => {
+  it('clears the session and marks local logout using the request origin', async () => {
+    const { target } = await logout();
+    expect(target.origin).toBe('https://wardrobe.example');
+    expect(target.pathname).toBe('/login');
+    expect(target.searchParams.get('loggedOut')).toBe('1');
+    expect(getToken).not.toHaveBeenCalled();
+  });
+
+  it('normalizes the configured application URL without dropping the logout marker', async () => {
+    vi.stubEnv('NEXTAUTH_URL', 'https://configured.example///');
+    const { target } = await logout();
+    expect(target.href).toBe('https://configured.example/login?loggedOut=1');
+    expect(getToken).not.toHaveBeenCalled();
+  });
+
+  it('prioritizes the proxy logout over TinyAuth and OIDC without reading an ID token', async () => {
+    vi.stubEnv('FORWARD_AUTH_LOGOUT_URL', 'https://proxy.example/logout?return=wardrobe');
+    vi.stubEnv('TINYAUTH_URL', 'https://tiny.example');
+    vi.stubEnv('OIDC_END_SESSION_URL', 'https://oidc.example/end');
+    const { target } = await logout();
+    expect(target.href).toBe('https://proxy.example/logout?return=wardrobe');
+    expect(getToken).not.toHaveBeenCalled();
+  });
+
+  it('uses normalized TinyAuth logout ahead of OIDC and returns to the logged-out page', async () => {
+    vi.stubEnv('TINYAUTH_URL', 'https://tiny.example///');
+    vi.stubEnv('OIDC_END_SESSION_URL', 'https://oidc.example/end');
+    const { target } = await logout();
+    expect(target.origin).toBe('https://tiny.example');
+    expect(target.pathname).toBe('/logout');
+    expect(target.searchParams.get('redirect_uri')).toBe('https://wardrobe.example/login?loggedOut=1');
+    expect(getToken).not.toHaveBeenCalled();
+  });
+
+  it('preserves OIDC parameters and sends the server ID token with a normalized return URL', async () => {
+    vi.stubEnv('NEXTAUTH_URL', 'https://configured.example///');
+    vi.stubEnv('OIDC_END_SESSION_URL', 'https://oidc.example/end?tenant=fixture&post_logout_redirect_uri=old');
+    vi.stubEnv('OIDC_CLIENT_ID', 'public-client');
+    vi.stubEnv('NEXTAUTH_SECRET', 'public-test-secret');
+    vi.mocked(getToken).mockResolvedValue({ oidcIdToken: 'public-id-token' });
+    const { request, target } = await logout();
+    expect(target.origin).toBe('https://oidc.example');
+    expect(target.pathname).toBe('/end');
+    expect(target.searchParams.get('tenant')).toBe('fixture');
+    expect(target.searchParams.getAll('post_logout_redirect_uri')).toEqual(['https://configured.example/login?loggedOut=1']);
+    expect(target.searchParams.get('id_token_hint')).toBe('public-id-token');
+    expect(target.searchParams.has('client_id')).toBe(false);
+    expect(getToken).toHaveBeenCalledExactlyOnceWith({ req: request, secret: 'public-test-secret' });
+  });
+
+  it('uses the client ID fallback when the server session has no ID token', async () => {
+    vi.stubEnv('OIDC_END_SESSION_URL', 'https://oidc.example/end?tenant=fixture');
+    vi.stubEnv('OIDC_CLIENT_ID', 'public-client');
+    const { target } = await logout();
+    expect(target.searchParams.get('tenant')).toBe('fixture');
+    expect(target.searchParams.get('client_id')).toBe('public-client');
+    expect(target.searchParams.has('id_token_hint')).toBe(false);
+    expect(target.searchParams.get('post_logout_redirect_uri')).toBe('https://wardrobe.example/login?loggedOut=1');
+    expect(getToken).toHaveBeenCalledTimes(1);
+  });
+
+  it('does not invent OIDC credentials when both ID token and client ID are absent', async () => {
+    vi.stubEnv('OIDC_END_SESSION_URL', 'https://oidc.example/end');
+    const { target } = await logout();
+    expect(target.searchParams.has('id_token_hint')).toBe(false);
+    expect(target.searchParams.has('client_id')).toBe(false);
+    expect(getToken).toHaveBeenCalledTimes(1);
+  });
+});
