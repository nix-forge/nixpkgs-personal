diff --git a/tests/outfit-browsing.test.tsx b/tests/outfit-browsing.test.tsx
new file mode 100644
--- /dev/null
+++ b/tests/outfit-browsing.test.tsx
@@ -0,0 +1,190 @@
+import React from 'react';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import OutfitsPage from '@/app/dashboard/outfits/page';
+import { api } from '@/lib/api';
+import { queryKeys } from '@/lib/hooks/query-keys';
+
+const navigation = vi.hoisted(() => ({
+  search: '',
+  listeners: new Set<() => void>(),
+  history: [] as string[],
+}));
+vi.mock('next/navigation', async () => {
+  const React = await import('react');
+  const replace = (url: string) => {
+    navigation.history.push(url);
+    navigation.search = new URL(url, 'http://localhost').search;
+    navigation.listeners.forEach(fn => fn());
+  };
+  const router = { replace, push: replace, back: vi.fn() };
+  return {
+    useRouter: () => router,
+    useSearchParams: () => new URLSearchParams(React.useSyncExternalStore(
+      fn => { navigation.listeners.add(fn); return () => { navigation.listeners.delete(fn); }; },
+      () => navigation.search,
+    )),
+    usePathname: () => '/dashboard/outfits',
+  };
+});
+vi.mock('@/lib/api', () => ({ api: { get: vi.fn() }, setAccessToken: vi.fn() }));
+vi.mock('next/image', () => ({ default: ({ fill, priority, ...props }: any) => <img {...props} /> }));
+vi.mock('next/link', () => ({ default: ({ children, ...props }: any) => <a {...props}>{children}</a> }));
+
+const outfits = Array.from({ length: 108 }, (_, index) => ({
+  id: `outfit-${index + 1}`, name: `Outfit ${index + 1}`,
+  source: 'manual', occasion: 'casual', scheduled_for: null,
+  created_at: '2026-01-01T00:00:00Z', items: [],
+}));
+let records = outfits;
+const nextButton = () => screen.getAllByRole('button', { name: 'nextPage' })[0];
+const previousButton = () => screen.getAllByRole('button', { name: 'previousPage' })[0];
+
+function mount() {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  render(<QueryClientProvider client={client}><OutfitsPage /></QueryClientProvider>);
+  return client;
+}
+
+beforeEach(() => {
+  cleanup(); navigation.search = ''; navigation.history = []; records = outfits; vi.clearAllMocks();
+  vi.mocked(api.get).mockImplementation(async (route, options) => {
+    if (route === '/users/me') return { timezone: 'UTC' } as any;
+    if (route === '/outfits/calendar') return { outfits: [] } as any;
+    const params = options?.params ?? {};
+    const page = Number(params.page ?? 1), size = Number(params.page_size ?? 24);
+    const matching = params.source === 'scheduled,on_demand' ? [] : records.filter(outfit => !params.search || outfit.name.includes(params.search));
+    return { outfits: matching.slice((page - 1) * size, page * size), total: matching.length,
+      page, page_size: size, has_more: page * size < matching.length } as any;
+  });
+});
+
+describe('outfit browsing', () => {
+  it('keeps earlier outfits reachable after loading the next results', async () => {
+    records = outfits.slice(0, 25);
+    mount();
+    await screen.findByRole('heading', { name: 'Outfit 1' });
+    fireEvent.click(screen.queryAllByRole('button', { name: 'nextPage' })[0] ?? screen.getByRole('button', { name: 'loadMore' }));
+    await screen.findByRole('heading', { name: 'Outfit 25' });
+    const previous = screen.queryAllByRole('button', { name: 'previousPage' })[0];
+    if (previous) fireEvent.click(previous);
+    await waitFor(() => expect(screen.getByRole('heading', { name: 'Outfit 1' })).toBeInTheDocument());
+  });
+
+  it('can browse all 108 outfits once and jump back, rendering at most 24 at a time', async () => {
+    mount();
+    const seen = new Set<string>();
+    for (let page = 1; page <= 5; page++) {
+      await screen.findByRole('heading', { name: `Outfit ${(page - 1) * 24 + 1}` });
+      const cards = screen.getAllByRole('heading', { level: 3 });
+      expect(cards.length).toBeLessThanOrEqual(24);
+      cards.forEach(card => seen.add(card.textContent!));
+      if (page < 5) fireEvent.click(nextButton());
+    }
+    expect(seen.size).toBe(108);
+    expect(nextButton()).toBeDisabled();
+    fireEvent.change(screen.getAllByRole('combobox', { name: 'choosePage' })[0], { target: { value: '1' } });
+    await screen.findByRole('heading', { name: 'Outfit 1' });
+    expect(previousButton()).toBeDisabled();
+  }, 30_000);
+
+  it('keeps the loaded cards visible and locks controls while the next page is delayed', async () => {
+    const base = vi.mocked(api.get).getMockImplementation()!;
+    let resolvePage!: (value: any) => void;
+    vi.mocked(api.get).mockImplementation((route, options) => Number(options?.params?.page) === 2
+      ? new Promise(resolve => { resolvePage = resolve; }) : base(route, options));
+    mount();
+    await screen.findByRole('heading', { name: 'Outfit 1' });
+    fireEvent.click(nextButton());
+    await screen.findByRole('status');
+    expect(screen.getByRole('heading', { name: 'Outfit 1' })).toBeInTheDocument();
+    expect(nextButton()).toBeDisabled();
+    expect(previousButton()).toBeDisabled();
+    await act(async () => resolvePage(await base('/outfits', { params: { page: '2', page_size: '24' } })));
+    await screen.findByRole('heading', { name: 'Outfit 25' });
+  });
+
+  it('preserves the last successful page after an error and retries the requested page', async () => {
+    const base = vi.mocked(api.get).getMockImplementation()!;
+    let fail = true;
+    vi.mocked(api.get).mockImplementation((route, options) => Number(options?.params?.page) === 2 && fail
+      ? Promise.reject(new Error('Page unavailable')) : base(route, options));
+    mount();
+    await screen.findByRole('heading', { name: 'Outfit 1' });
+    fireEvent.click(nextButton());
+    await screen.findByRole('alert');
+    expect(screen.getByRole('heading', { name: 'Outfit 1' })).toBeInTheDocument();
+    fail = false;
+    fireEvent.click(screen.getByRole('button', { name: 'retry' }));
+    await screen.findByRole('heading', { name: 'Outfit 25' });
+    expect(screen.queryByRole('alert')).not.toBeInTheDocument();
+  });
+
+  it('resets the page when filters change and never displays the previous filter results', async () => {
+    navigation.search = '?page=3';
+    mount();
+    await screen.findByRole('heading', { name: 'Outfit 49' });
+    fireEvent.click(screen.getByRole('button', { name: 'filters.ai' }));
+    await screen.findByText('empty.ai');
+    expect(new URLSearchParams(navigation.search).has('page')).toBe(false);
+    expect(screen.queryAllByRole('heading', { level: 3 })).toHaveLength(0);
+  });
+
+  it('debounces a lookbook search and resets it to the first page atomically', async () => {
+    navigation.search = '?filter=my-looks&page=3';
+    mount();
+    await screen.findByRole('heading', { name: 'Outfit 49' });
+    fireEvent.change(screen.getByPlaceholderText('search'), { target: { value: 'Outfit 1' } });
+    await screen.findByRole('heading', { name: 'Outfit 1' });
+    const requests = vi.mocked(api.get).mock.calls.filter(([, options]) => options?.params?.search);
+    expect(requests.length).toBeGreaterThan(0);
+    expect(requests.every(([, options]) => options?.params?.page === '1')).toBe(true);
+    expect(new URLSearchParams(navigation.search).get('search')).toBe('Outfit 1');
+  });
+
+  it('recovers a page past the last result after deletion or a stale bookmark', async () => {
+    navigation.search = '?page=9';
+    mount();
+    await screen.findByRole('heading', { name: 'Outfit 97' });
+    expect(new URLSearchParams(navigation.search).get('page')).toBe('5');
+  });
+
+  it('restores a previous URL and links details back to the visible page', async () => {
+    navigation.search = '?filter=my-looks&page=3';
+    mount();
+    await screen.findByRole('heading', { name: 'Outfit 49' });
+    expect(screen.getByRole('link', { name: /Outfit 49/ }).getAttribute('href')).toContain(encodeURIComponent('/dashboard/outfits?filter=my-looks&page=3'));
