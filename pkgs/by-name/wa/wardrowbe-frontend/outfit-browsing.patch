+'use client';
+
+import { useState } from 'react';
+import Image from 'next/image';
+import { Shirt } from 'lucide-react';
+import { useTranslations } from 'next-intl';
+import { useTypeLabel } from '@/lib/hooks/use-translated-constants';
+import type { OutfitItem } from '@/lib/hooks/use-outfits';
+
+export function OutfitGarmentImage({ item, small = false }: { item: OutfitItem; small?: boolean }) {
+  const t = useTranslations('outfits.cards');
+  const typeLabel = useTypeLabel();
+  const [failed, setFailed] = useState<string[]>([]);
+  const source = [item.image_url, item.thumbnail_url].find(url => url && !failed.includes(url));
+  const name = item.name || typeLabel(item.type);
+  return source ? (
+    <Image key={source} src={source} alt={name} fill
+      className="object-contain p-2" loading="lazy"
+      sizes={small ? '72px' : '(min-width: 1280px) 200px, (min-width: 768px) 25vw, 50vw'}
+      onError={() => setFailed(previous => [...previous, source])} />
+  ) : (
+    <div className="flex h-full flex-col items-center justify-center gap-2 p-2 text-center text-muted-foreground" role="img" aria-label={t('imageUnavailable', { name })} title={t('imageUnavailable', { name })}>
+      <Shirt className="h-6 w-6" aria-hidden="true" />
+      {!small && <span className="line-clamp-3 text-[10px]">{t('imageUnavailable', { name })}</span>}
+    </div>
+  );
+}
