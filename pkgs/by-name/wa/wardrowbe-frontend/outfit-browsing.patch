new file mode 100644
--- /dev/null
+++ b/components/outfits/outfit-pagination.tsx
@@ -0,0 +1,44 @@
+'use client';
+
+import { ChevronLeft, ChevronRight } from 'lucide-react';
+import { useTranslations } from 'next-intl';
+import { Button } from '@/components/ui/button';
+
+interface OutfitPaginationProps {
+  page: number;
+  total: number;
+  pageSize: number;
+  busy: boolean;
+  position: 'top' | 'bottom';
+  onPageChange: (page: number) => void;
+}
+
+export function OutfitPagination({ page, total, pageSize, busy, position, onPageChange }: OutfitPaginationProps) {
+  const t = useTranslations('outfits.pagination');
+  const tc = useTranslations('common');
+  const pages = Math.max(1, Math.ceil(total / pageSize));
+  return (
+    <nav aria-label={t(position)} className="flex flex-wrap items-center justify-between gap-3 rounded-lg border bg-background p-3">
+      <p className="text-sm text-muted-foreground" aria-live="polite">
+        {t('range', { start: total ? (page - 1) * pageSize + 1 : 0, end: Math.min(page * pageSize, total), total })}
+      </p>
+      <div className="flex items-center gap-2">
+        <Button type="button" variant="outline" size="icon" aria-label={tc('previousPage')}
+          disabled={busy || page <= 1} onClick={() => onPageChange(page - 1)}>
+          <ChevronLeft className="h-4 w-4" aria-hidden="true" />
+        </Button>
+        <select aria-label={t('choosePage')} value={page} disabled={busy}
+          onChange={event => onPageChange(Number(event.target.value))}
+          className="h-10 max-w-44 rounded-md border border-input bg-background px-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
+          {Array.from({ length: pages }, (_, index) => (
+            <option key={index + 1} value={index + 1}>{tc('pageOf', { page: index + 1, totalPages: pages })}</option>
+          ))}
+        </select>
+        <Button type="button" variant="outline" size="icon" aria-label={tc('nextPage')}
+          disabled={busy || page >= pages} onClick={() => onPageChange(page + 1)}>
+          <ChevronRight className="h-4 w-4" aria-hidden="true" />
+        </Button>
+      </div>
+    </nav>
+  );
+}
