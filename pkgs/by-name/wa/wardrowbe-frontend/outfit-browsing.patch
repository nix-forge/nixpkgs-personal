+import React from 'react';
+import { describe, expect, it, vi } from 'vitest';
+import { cleanup, fireEvent, render, screen } from '@testing-library/react';
+import { beforeEach } from 'vitest';
+import { OutfitCard } from '@/components/outfits/outfit-card';
+import type { Outfit } from '@/lib/hooks/use-outfits';
+
+vi.mock('@/lib/hooks/use-user', () => ({ useUserToday: () => () => '2026-01-01' }));
+
+vi.mock('next/image', () => ({ default: ({ fill, priority, ...props }: any) => <img {...props} /> }));
+vi.mock('next/link', () => ({ default: ({ children, ...props }: any) => <a {...props}>{children}</a> }));
+
+const types = ['t-shirt', 'pants', 'jacket', 'socks', 'accessories', 'shoes'];
+const outfit = {
+  id: 'look-1', name: 'A complete casual outfit', source: 'manual', occasion: 'casual',
+  scheduled_for: null, created_at: '2026-01-01T00:00:00Z',
+  items: types.map((type, position) => ({ id: `item-${position}`, type,
+    name: `Garment ${type}`, position, layer_type: null,
+    image_url: `/images/full-${position}.jpg`, thumbnail_url: `/images/thumb-${position}.jpg`,
+  })),
+} as Outfit;
+
+describe('outfit preview', () => {
+  beforeEach(() => cleanup());
+  it('shows every garment, including footwear, using uncropped full images', () => {
+    render(<OutfitCard outfit={outfit} />);
+    expect(screen.getAllByRole('img')).toHaveLength(6);
+    for (const item of outfit.items) {
+      const image = screen.getByRole('img', { name: item.name! });
+      expect(image).toHaveAttribute('src', item.image_url);
+      expect(image).toHaveClass('object-contain');
+    }
+  });
+  it('falls back to the thumbnail and then a named placeholder if an image fails', () => {
+    render(<OutfitCard outfit={outfit} />);
+    const item = outfit.items[0];
+    fireEvent.error(screen.getByRole('img', { name: item.name! }));
+    expect(screen.getByRole('img', { name: item.name! })).toHaveAttribute('src', item.thumbnail_url);
+    fireEvent.error(screen.getByRole('img', { name: item.name! }));
+    expect(screen.queryByRole('img', { name: item.name! })).not.toBeInTheDocument();
+    expect(screen.getByText('imageUnavailable')).toBeInTheDocument();
+    expect(screen.getAllByRole('img')).toHaveLength(6);
+    expect(screen.getByRole('img', { name: 'imageUnavailable' })).not.toHaveAttribute('src');
+  });
+  it('keeps selection and keyboard activation working without opening a detail link', () => {
+    const select = vi.fn();
+    render(<OutfitCard outfit={outfit} selectMode selected={false} onSelect={select} />);
+    fireEvent.keyDown(screen.getByRole('button'), { key: 'Enter' });
+    expect(select).toHaveBeenCalledWith('look-1', true);
+    select.mockClear();
+    fireEvent.click(screen.getByRole('checkbox'));
+    expect(select).toHaveBeenCalledTimes(1);
+    expect(screen.queryByRole('link')).not.toBeInTheDocument();
+  });
+  it('preserves the upstream replacement title resolver when no name is saved', () => {
+    render(<OutfitCard outfit={{ ...outfit, name: null, replaces_outfit_id: 'original-look', reasoning: 'Generic explanation' }} />);
+    expect(screen.getByRole('heading', { name: 'woreInsteadFallback' })).toBeInTheDocument();
+    expect(screen.queryByRole('heading', { name: 'Generic explanation' })).not.toBeInTheDocument();
+  });
+
+});
