@@ -0,0 +1,289 @@
+import React from 'react';
+import {
+  render,
+  screen,
+  waitFor,
+  fireEvent,
+  cleanup,
+} from '@testing-library/react';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { OpenAISettings } from '@/components/openai-settings';
+import { api } from '@/lib/api';
+
+vi.mock('next-auth/react', () => ({
+  useSession: () => ({
+    status: 'authenticated',
+    data: { accessToken: 'public-fixture' },
+  }),
+}));
+vi.mock('@/lib/api', () => ({
+  api: { get: vi.fn(), post: vi.fn() },
+  setAccessToken: vi.fn(),
+}));
+afterEach(cleanup);
+beforeEach(() => vi.clearAllMocks());
+
+const endpoint = 'http://127.0.0.1:18182/v1';
+const saved = {
+  name: 'OpenAI account',
+  url: endpoint,
+  vision_model: 'vision-selected',
+  text_model: 'text-selected',
+  enabled: true,
+};
+function mount(
+  endpoints = [saved],
+  onSelect = vi.fn().mockResolvedValue(undefined),
+) {
+  const client = new QueryClient({
+    defaultOptions: { queries: { retry: false, gcTime: 0 } },
+  });
+  const tree = (values: typeof endpoints) => (
+    <QueryClientProvider client={client}>
+      <OpenAISettings endpoints={values} onSelect={onSelect} />
+    </QueryClientProvider>
+  );
+  return { ...render(tree(endpoints)), tree, onSelect, client };
+}
+
+describe('OpenAI Settings', () => {
+  it('restores saved models after preferences arrive, and saves the chosen models', async () => {
+    vi.mocked(api.get).mockResolvedValue({
+      enabled: true,
+      connected: true,
+      models: ['first-model', 'vision-selected', 'text-selected'],
+      endpoint,
+    });
+    const view = mount([]);
+    await screen.findByText('Connected to OpenAI');
+    view.rerender(view.tree([saved]));
+    await waitFor(() => {
+      expect(
+        (screen.getByLabelText('Photo analysis model') as HTMLSelectElement)
+          .value,
+      ).toBe('vision-selected');
+      expect(
+        (
+          screen.getByLabelText(
+            'Outfits and pairings model',
+          ) as HTMLSelectElement
+        ).value,
+      ).toBe('text-selected');
+    });
+    fireEvent.click(screen.getByText('Use OpenAI for my wardrobe'));
+    await waitFor(() =>
+      expect(view.onSelect).toHaveBeenCalledWith(
+        endpoint,
+        'vision-selected',
+        'text-selected',
+      ),
+    );
+    await screen.findByText(/Saved. New AI requests/);
+    view.client.clear();
+  });
+
+  it('selects automatic value even when fixed models were previously saved', async () => {
+    vi.mocked(api.get).mockResolvedValue({
+      enabled: true,
+      connected: true,
+      models: ['auto-value', 'vision-selected', 'text-selected'],
+      endpoint,
+      selection: {
+        text_model: 'catalog-text-choice',
+        vision_model: 'catalog-image-choice',
+        reason: 'Available account models ranked by metadata',
+        refreshed_at: '2026-01-01T00:00:00Z',
+      },
+    });
+    const view = mount();
+    await screen.findByText('Connected to OpenAI');
+    await waitFor(() =>
+      expect(screen.getByLabelText('Photo analysis model')).toHaveValue(
+        'vision-selected',
+      ),
+    );
+    expect(
+      screen.getByText('Current outfit model: catalog-text-choice'),
+    ).toBeInTheDocument();
+    expect(
+      screen.getByText('Current photo model: catalog-image-choice'),
+    ).toBeInTheDocument();
+    expect(
+      screen.getByText('Available account models ranked by metadata'),
+    ).toBeInTheDocument();
+    fireEvent.click(screen.getByText('Use automatic model selection'));
+    await waitFor(() =>
+      expect(view.onSelect).toHaveBeenCalledWith(
+        endpoint,
+        'auto-value',
+        'auto-value',
+      ),
+    );
+    expect(screen.getByLabelText('Photo analysis model')).toHaveValue(
+      'auto-value',
+    );
+    expect(screen.getByLabelText('Outfits and pairings model')).toHaveValue(
+      'auto-value',
+    );
+    view.client.clear();
+  });
+  it('defaults unsaved choices to automatic and preserves manual selection', async () => {
+    vi.mocked(api.get).mockResolvedValue({
+      enabled: true,
+      connected: true,
+      models: ['manual-model', 'auto-value'],
+      endpoint,
+    });
+    const view = mount([]);
+    await screen.findByText('Connected to OpenAI');
+    await waitFor(() =>
+      expect(screen.getByLabelText('Photo analysis model')).toHaveValue(
+        'auto-value',
+      ),
+    );
+    expect(screen.getByLabelText('Outfits and pairings model')).toHaveValue(
+      'auto-value',
+    );
+    fireEvent.change(screen.getByLabelText('Photo analysis model'), {
+      target: { value: 'manual-model' },
+    });
+    fireEvent.change(screen.getByLabelText('Outfits and pairings model'), {
+      target: { value: 'manual-model' },
+    });
+    fireEvent.click(screen.getByText('Use OpenAI for my wardrobe'));
+    await waitFor(() =>
+      expect(view.onSelect).toHaveBeenCalledWith(
+        endpoint,
+        'manual-model',
+        'manual-model',
+      ),
+    );
+    view.client.clear();
+  });
+  it('defaults to ordinary browser OAuth without a device code', async () => {
+    vi.mocked(api.get).mockResolvedValue({
+      enabled: true,
+      connected: false,
+      models: ['fixture'],
+      endpoint,
+    });
+    const view = mount();
+    await screen.findByText('Not connected');
+    vi.mocked(api.post).mockResolvedValue({});
+    vi.mocked(api.get).mockResolvedValue({
+      enabled: true,
+      connected: false,
+      models: ['fixture'],
+      endpoint,
+      pending: {
+        method: 'browser',
+        authUrl: 'https://auth.openai.com/oauth/authorize?state=public-fixture',
+        expiresAt: 2000000000,
+      },
+    });
+    fireEvent.click(screen.getByText('Connect OpenAI'));
+    const link = await screen.findByText('Open OpenAI sign-in');
+    expect(api.post).toHaveBeenCalledWith(
+      '/users/me/preferences/openai/login?method=browser',
+    );
+    expect(link.getAttribute('href')).toBe(
+      'https://auth.openai.com/oauth/authorize?state=public-fixture',
+    );
+    expect(screen.queryByText('TEST-CODE')).toBeNull();
+    fireEvent.click(screen.getByText('Cancel sign-in'));
+    await waitFor(() =>
+      expect(api.post).toHaveBeenCalledWith(
+        '/users/me/preferences/openai/disconnect',
+      ),
+    );
+    view.client.clear();
+  });
+
