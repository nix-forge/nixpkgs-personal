+#[cfg(all(test, target_os = "linux"))]
+mod fontconfig_discovery_tests {
+    use super::*;
+    use std::os::unix::ffi::OsStrExt;
+    use std::os::unix::process::ExitStatusExt;
+
+    fn output(status: i32, stdout: &[u8]) -> std::io::Result<std::process::Output> {
+        Ok(std::process::Output { status: std::process::ExitStatus::from_raw(status), stdout: stdout.to_vec(), stderr: Vec::new() })
+    }
+
+    #[test]
+    fn configured_directories_are_sorted_and_deduplicated() {
+        assert_eq!(
+            fontconfig_dirs_from_command(output(0, b"/fonts/z/a.ttf\n/fonts/a/b.otf\n/fonts/z/c.ttc\n")),
+            vec![PathBuf::from("/fonts/a"), PathBuf::from("/fonts/z")]
+        );
+    }
+
+    #[test]
+    fn failed_command_keeps_the_folder_fallback() {
+        assert!(fontconfig_dirs_from_command(Err(std::io::Error::from(std::io::ErrorKind::NotFound))).is_empty());
+        assert!(fontconfig_dirs_from_command(output(1 << 8, b"/fonts/a.ttf\n")).is_empty());
+    }
+
+    #[test]
+    fn empty_relative_and_invalid_paths_are_ignored_without_losing_os_bytes() {
+        assert!(fontconfig_dirs_from_command(output(0, b"\nrelative/a.ttf\n/fonts/\0bad.ttf\n")).is_empty());
+        let dirs = fontconfig_dirs_from_command(output(0, b"/fonts/\xff/a.ttf\n"));
+        assert_eq!(dirs, vec![PathBuf::from(std::ffi::OsStr::from_bytes(b"/fonts/\xff"))]);
+    }
+
+    #[test]
+    fn a_font_available_only_through_fontconfig_output_is_scanned() -> Result<(), Box<dyn std::error::Error>> {
+        let directory = std::env::temp_dir().join(format!("effectcraft-fontconfig-discovery-{}", std::process::id()));
+        std::fs::create_dir_all(&directory)?;
+        let font = directory.join("configured.ttf");
+        std::fs::write(&font, NOTO_SERIF_REGULAR)?;
+        let mut stdout = font.as_os_str().as_bytes().to_vec();
+        stdout.push(b'\n');
+        let source = DirectorySource { dirs: fontconfig_dirs_from_command(output(0, &stdout)) };
+        let found = source.faces().iter().any(|face| face.family == "Noto Serif" && face.origin == "system");
+        std::fs::remove_dir_all(&directory)?;
+        assert!(found);
+        Ok(())
     }
