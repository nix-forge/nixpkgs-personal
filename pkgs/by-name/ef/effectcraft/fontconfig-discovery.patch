+/// Ask fontconfig for configured font files rather than interpreting its XML ourselves.
+/// Missing fontconfig, failed commands and malformed output retain the existing folder fallback.
+#[cfg(target_os = "linux")]
+fn fontconfig_dirs_from_command(output: std::io::Result<std::process::Output>) -> Vec<PathBuf> {
+    use std::os::unix::ffi::OsStrExt;
+    let Ok(output) = output else { return Vec::new() };
+    if !output.status.success() {
+        return Vec::new();
+    }
+    let mut dirs: Vec<PathBuf> = output
+        .stdout
+        .split(|b| *b == b'\n')
+        .filter(|line| !line.is_empty() && !line.contains(&0))
+        .map(|line| std::path::Path::new(std::ffi::OsStr::from_bytes(line)))
+        .filter(|path| path.is_absolute())
+        .filter_map(|path| path.parent().map(std::path::Path::to_path_buf))
+        .collect();
+    dirs.sort();
+    dirs.dedup();
+    dirs
+}
