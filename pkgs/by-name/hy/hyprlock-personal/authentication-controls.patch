+bool CHyprlock::canSubmitPassword() {
+    static const auto IGNOREEMPTY = g_pConfigManager->getValue<Hyprlang::INT>("general:ignore_empty_input");
+    return m_sLockState.locked && !isFadingOutOrTerminating() && !g_pAuth->checkWaiting() && (!m_sPasswordState.passBuffer.empty() || !*IGNOREEMPTY);
+}
+
+void CHyprlock::submitPasswordFromPointer() {
+    // Pointer input must retain the guards normally applied by onKey before
+    // entering the existing Return handler. PAM remains the only password authority.
+    if (!canSubmitPassword())
+        return;
+    if (g_pAuth->m_bDisplayFailText)
+        g_pAuth->resetDisplayFail();
+    handleKeySym(XKB_KEY_Return, false);
+    renderAllOutputs();
+}
