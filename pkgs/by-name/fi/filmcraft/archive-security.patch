+//! Original synthetic ZIP fixtures for the voice and tensor-reader boundaries.
+use std::io::{Cursor, Read, Write};
+use std::path::Path;
+
+use candle_core::{Device, Tensor, npy::NpzTensors, pickle::PthTensors};
+
+fn archive(entries: &[(&str, &[u8])]) -> Vec<u8> {
+    let mut writer = zip::ZipWriter::new(Cursor::new(Vec::new()));
+    for (name, data) in entries {
+        writer.start_file(*name, zip::write::SimpleFileOptions::default().compression_method(zip::CompressionMethod::Stored)).unwrap();
+        writer.write_all(data).unwrap();
+    }
+    writer.finish().unwrap().into_inner()
+}
+
+fn voice() -> Vec<u8> {
+    archive(&[("voice/data/0", &vec![0; super::PACK_LEN * super::STYLE * 4]), ("voice/byteorder", b"little"), ("unused", b"")])
+}
+
+fn pth() -> Vec<u8> {
+    // Protocol-2 dictionary: a one-element float32 tensor rebuilt from persistent storage.
+    fn string(bytes: &mut Vec<u8>, value: &str) {
+        bytes.push(b'X');
+        bytes.extend_from_slice(&(value.len() as u32).to_le_bytes());
+        bytes.extend_from_slice(value.as_bytes());
+    }
+    let mut pickle = b"\x80\x02}".to_vec();
+    string(&mut pickle, "weight");
+    pickle.extend_from_slice(b"ctorch._utils\n_rebuild_tensor_v2\n((");
+    string(&mut pickle, "storage");
+    pickle.extend_from_slice(b"ctorch\nFloatStorage\n");
+    string(&mut pickle, "0");
+    string(&mut pickle, "cpu");
+    pickle.extend_from_slice(b"K\x01tQK\x00K\x01\x85K\x01\x85\x89}tRs.");
+    archive(&[("model/data.pkl", &pickle), ("model/data/0", &7.0_f32.to_le_bytes()), ("unused", b"")])
+}
+
+fn npz(path: &Path) -> Vec<u8> {
+    let tensor = Tensor::new(&[7.0_f32], &Device::Cpu).unwrap();
+    Tensor::write_npz(&[("weight", &tensor)], path).unwrap();
+    std::fs::read(path).unwrap()
+}
+
+fn header(bytes: &[u8], name: &str) -> usize {
+    let mut zip = zip::ZipArchive::new(Cursor::new(bytes)).unwrap();
+    let start = zip.by_name(name).unwrap().header_start();
+    start as usize
+}
+
+fn check(bytes: &[u8], required: &str, extra_parts: bool, accepts: impl Fn(&[u8]) -> bool) {
+    assert!(accepts(bytes), "ordinary control");
+    for (label, offset) in [("local filename", 30), ("compression", 8), ("CRC", 14)] {
+        let mut bad = bytes.to_vec();
+        bad[header(bytes, required) + offset] ^= 1;
+        assert!(!accepts(&bad), "{label}");
+    }
+    if !extra_parts {
+        assert!(accepts(&zip64(bytes)), "ZIP64 control");
+        return;
+    }
+    let extra = append(bytes.to_vec(), b"spare", b"spare", &[], &[], false, false);
+    let mut bad = extra.clone();
+    bad[header(&extra, "spare") + 30] ^= 1;
+    assert!(!accepts(&bad), "ignored header");
+    for name in ["unused-alias", "文"] {
+        let alias = unicode_path(name, 0x4ddb0c25);
+        assert!(!accepts(&append(bytes.to_vec(), b"plumless", b"buckeroo", &alias, &alias, false, false)), "UnicodePath CRC collision");
+    }
+    assert!(!accepts(&append(extra, b"spare", b"spare", &[], &[], false, false)), "duplicate names");
+    let legacy = append(bytes.to_vec(), b"caf\x82.txt", b"caf\x82.txt", &[], &[], false, false);
+    assert!(!accepts(&append(legacy, "café.txt".as_bytes(), "café.txt".as_bytes(), &[], &[], false, true)), "duplicate decoded names");
+    assert!(!accepts(&unlisted(bytes.to_vec())), "unlisted local header");
+    for (local, central) in [(true, false), (false, true)] {
+        assert!(!accepts(&encoding_flags(bytes.to_vec(), b"caf\xc3\xa9", local, central)), "encoding mismatch");
+        assert!(accepts(&encoding_flags(bytes.to_vec(), b"ascii", local, central)), "ASCII flag control");
+    }
+    let alias = unicode_path("café.txt", 0xa0976e8f);
+    assert!(accepts(&append(bytes.to_vec(), b"caf\x82.txt", b"caf\x82.txt", &alias, &alias, false, false)), "UnicodePath control");
+    assert!(accepts(&append(bytes.to_vec(), b"notes", b"notes", &[], &[], true, false)), "stream descriptor");
+    assert!(accepts(&zip64(bytes)), "ZIP64 control");
+}
