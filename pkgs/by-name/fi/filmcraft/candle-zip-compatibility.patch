+/// Open a tensor archive only after checking every local and central entry.
+pub(crate) fn open_zip<R: std::io::Read + std::io::Seek>(reader: R) -> Result<zip::ZipArchive<R>> {
+    let mut archive = zip::ZipArchive::new(reader)?;
+    archive.validate_header_consistency()?;
+    Ok(archive)
+}
