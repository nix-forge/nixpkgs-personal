+#[test]
+fn ed25519_signatures_still_verify_and_invalid_inputs_fail() {
+    let key = ed25519_dalek::SigningKey::from_bytes(&[7; 32]);
+    let signature = key.sign(MESSAGE);
+    accepts_valid_rejects_invalid(
+        algorithm(alg_id::ED25519, alg_id::ED25519),
+        key.verifying_key().as_bytes(),
+        &signature.to_bytes(),
+    );
+}
+
+#[test]
+fn ecdsa_signatures_still_verify_and_invalid_inputs_fail() {
+    macro_rules! check {
+        ($curve:ident, $length:expr, $hash:ty, $algorithm:expr) => {
+            let key = $curve::ecdsa::SigningKey::from_slice(&[1; $length]).unwrap();
+            let signature: $curve::ecdsa::Signature =
+                key.sign_prehash(&<$hash>::digest(MESSAGE)).unwrap();
+            accepts_valid_rejects_invalid(
+                $algorithm,
+                key.verifying_key().to_encoded_point(false).as_bytes(),
+                signature.to_der().as_bytes(),
+            );
+        };
+    }
+    check!(
+        p256,
+        32,
+        sha2::Sha256,
+        algorithm(alg_id::ECDSA_P256, alg_id::ECDSA_SHA256)
+    );
+    check!(
+        p256,
+        32,
+        sha2::Sha384,
+        algorithm(alg_id::ECDSA_P256, alg_id::ECDSA_SHA384)
+    );
+    check!(
+        p384,
+        48,
+        sha2::Sha256,
+        algorithm(alg_id::ECDSA_P384, alg_id::ECDSA_SHA256)
+    );
+    check!(
+        p384,
+        48,
+        sha2::Sha384,
+        algorithm(alg_id::ECDSA_P384, alg_id::ECDSA_SHA384)
+    );
+}
+
+#[test]
+fn rsa_signatures_still_verify_and_invalid_inputs_fail() {
+    use ::rsa::pkcs1::EncodeRsaPublicKey;
+    let mut rng = rand_core::OsRng;
+    let key = ::rsa::RsaPrivateKey::new(&mut rng, 2048).unwrap();
+    let public = key.to_public_key().to_pkcs1_der().unwrap();
+    macro_rules! check {
+        ($padding:ident, $hash:ty, $algorithm:expr) => {
+            let signer = ::rsa::$padding::SigningKey::<$hash>::new(key.clone());
+            let signature = signer.sign_with_rng(&mut rng, MESSAGE);
+            accepts_valid_rejects_invalid($algorithm, public.as_bytes(), &signature.to_vec());
+        };
+    }
+    check!(
+        pkcs1v15,
+        sha2::Sha256,
+        algorithm(alg_id::RSA_ENCRYPTION, alg_id::RSA_PKCS1_SHA256)
+    );
+    check!(
+        pkcs1v15,
+        sha2::Sha384,
+        algorithm(alg_id::RSA_ENCRYPTION, alg_id::RSA_PKCS1_SHA384)
+    );
+    check!(
+        pkcs1v15,
+        sha2::Sha512,
+        algorithm(alg_id::RSA_ENCRYPTION, alg_id::RSA_PKCS1_SHA512)
+    );
+    check!(
+        pss,
+        sha2::Sha256,
+        algorithm(alg_id::RSA_ENCRYPTION, alg_id::RSA_PSS_SHA256)
+    );
+    check!(
+        pss,
+        sha2::Sha384,
+        algorithm(alg_id::RSA_ENCRYPTION, alg_id::RSA_PSS_SHA384)
+    );
+    check!(
+        pss,
+        sha2::Sha512,
+        algorithm(alg_id::RSA_ENCRYPTION, alg_id::RSA_PSS_SHA512)
+    );
