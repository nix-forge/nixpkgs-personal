+use rustls::pki_types::{alg_id, AlgorithmIdentifier, SignatureVerificationAlgorithm};
+use sha2::Digest;
+use signature::{hazmat::PrehashSigner, RandomizedSigner, SignatureEncoding, Signer};
+
+const MESSAGE: &[u8] = b"provider compatibility control";
+
+fn algorithm(
+    key: AlgorithmIdentifier,
+    signature: AlgorithmIdentifier,
+) -> &'static dyn SignatureVerificationAlgorithm {
+    rustls_rustcrypto::provider()
+        .signature_verification_algorithms
+        .all
+        .iter()
+        .copied()
+        .find(|algorithm| {
+            algorithm.public_key_alg_id() == key && algorithm.signature_alg_id() == signature
+        })
+        .expect("the original provider algorithm must remain available")
+}
+
+fn accepts_valid_rejects_invalid(
+    algorithm: &dyn SignatureVerificationAlgorithm,
+    key: &[u8],
+    signature: &[u8],
+) {
+    assert!(algorithm.verify_signature(key, MESSAGE, signature).is_ok());
+    assert!(algorithm
+        .verify_signature(key, b"different message", signature)
+        .is_err());
+    assert!(algorithm
+        .verify_signature(b"invalid key encoding", MESSAGE, signature)
+        .is_err());
+    assert!(algorithm
+        .verify_signature(key, MESSAGE, &signature[..signature.len() - 1])
+        .is_err());
+    let mut corrupt = signature.to_vec();
+    corrupt[0] ^= 1;
+    assert!(algorithm.verify_signature(key, MESSAGE, &corrupt).is_err());
+}
+
