+#[cfg(target_os = "linux")]
+#[test]
+fn fontconfig_listing_preserves_unix_paths_and_deduplicates_directories() {
+    use std::os::unix::ffi::OsStrExt;
+    let input = b"/nix/store/fonts with spaces/Regular.ttf\n/nix/store/fonts with spaces/Bold.ttf\nrelative.ttf\nrelative/font.ttf\n\n/fonts/\xff/Regular.ttf\n/fonts/\xff/Bold.ttf\n/bad\0/path.ttf\n/other/Font.otf\n";
+    assert_eq!(fontconfig_dirs_from_output(input), vec![
+        std::path::PathBuf::from(std::ffi::OsStr::from_bytes(b"/fonts/\xff")),
+        std::path::PathBuf::from("/nix/store/fonts with spaces"),
+        std::path::PathBuf::from("/other"),
+    ]);
+}
