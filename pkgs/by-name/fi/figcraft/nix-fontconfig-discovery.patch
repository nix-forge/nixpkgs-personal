+#[cfg(target_os = "linux")]
+#[test]
+fn fontconfig_selected_directory_indexes_a_real_font() {
+    use std::os::unix::ffi::OsStrExt;
+    // The unique directory is outside all conventional font locations. No host font needed.
+    let mut name = format!("figcraft-fontconfig-{}-", std::process::id()).into_bytes();
+    name.push(0xff);
+    let dir = std::env::temp_dir().join(std::ffi::OsStr::from_bytes(&name));
+    std::fs::create_dir(&dir).unwrap();
+    let font = CRAFT_FONTS.iter().find(|f| f.family == "Inter" && f.style == "Regular").unwrap();
+    let path = dir.join("font with spaces.ttf");
+    std::fs::write(&path, font.bytes).unwrap();
+    let mut listing = path.as_os_str().as_bytes().to_vec();
+    listing.push(b'\n');
+    let dirs = fontconfig_dirs_from_output(&listing);
+    let mut found = BTreeMap::new();
+    for dir in dirs {
+        scan_dir(&dir, 0, &mut found);
+        scan_dir(&dir, 0, &mut found);
+    }
+    assert_eq!(found.get("inter").unwrap().1.len(), 1);
+    let mut db = FontDb { pending: found, ..FontDb::default() };
+    let face = db.find("Inter", "Regular").unwrap();
+    assert!(face.has_char('A'));
+    std::fs::remove_dir_all(dir).unwrap();
+}
+
+#[test]
+fn every_pinned_craft_font_is_available_without_system_fonts() {
+    let mut db = FontDb::default();
+    for font in CRAFT_FONTS {
+        let face = Face::from_bytes(FontBytes::Static(font.bytes), 0, Some(font.family), Some(font.style)).unwrap();
+        db.add(face);
+    }
+    assert_eq!(db.face_count(), 57);
+    for font in CRAFT_FONTS {
+        assert!(db.find(font.family, font.style).is_some(), "{} {}", font.family, font.style);
+    }
+    assert!(db.find("Noto Sans CJK SC", "Regular").unwrap().has_char('中'));
+    assert!(db.find("Noto Sans Arabic", "Regular").unwrap().has_char('ع'));
+    if system_fonts_opted_out() {
+        db.scan_system();
+        assert!(!db.system_scanned);
+        assert!(db.pending.is_empty());
+    }
+}
