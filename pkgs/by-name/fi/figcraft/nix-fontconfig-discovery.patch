+// Query the host's configured font collection, including immutable Nix profile paths.
+// This subprocess is Linux-only; Darwin keeps its native font directories.
+#[cfg(target_os = "linux")]
+fn fontconfig_dirs() -> Vec<std::path::PathBuf> {
+    let Ok(output) = std::process::Command::new(env!("FIGCRAFT_FC_LIST"))
+        .args(["--format", "%{file}\\n"])
+        .output()
+    else { return Vec::new() };
+    if !output.status.success() {
+        return Vec::new();
+    }
+    fontconfig_dirs_from_output(&output.stdout)
+}
+
+#[cfg(target_os = "linux")]
+fn fontconfig_dirs_from_output(output: &[u8]) -> Vec<std::path::PathBuf> {
+    use std::os::unix::ffi::OsStrExt;
+    // Unix font paths are byte strings. Ignore malformed records without losing valid paths.
+    let mut dirs = std::collections::BTreeSet::new();
+    for line in output.split(|b| *b == b'\n') {
+        if line.is_empty() || line.contains(&0) {
+            continue;
+        }
+        let path = std::path::Path::new(std::ffi::OsStr::from_bytes(line));
+        if path.is_absolute() && let Some(parent) = path.parent() {
+            dirs.insert(parent.to_path_buf());
+        }
+    }
+    dirs.into_iter().collect()
 }
 
