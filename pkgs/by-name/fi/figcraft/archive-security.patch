+#[test]
+fn zip_archive_encoding_flags() {
+    for (local, central) in [(true, false), (false, true)] {
+        let bad = encoding_flags(native(), b"caf\xc3\xa9", local, central);
+        assert!(crate::load_bytes(&bad).is_err(), "filename encoding mismatch");
+        assert!(crate::read_library(Cursor::new(&bad)).is_err());
+        assert!(crate::read_library_within(Cursor::new(&bad), 1 << 20).is_err());
+        assert!(crate::thumbnail::thumbnail_png(Cursor::new(&bad)).is_none());
+        assert_eq!(crate::thumbnail::archive_preview(Cursor::new(&bad), 8), crate::thumbnail::Preview::default());
+        let bad = encoding_flags(fig(), b"caf\xc3\xa9", local, central);
+        assert!(matches!(crate::fig::try_import(&bad, "Synthetic.fig"), Some(Err(_))));
+
+        // Different flags are harmless when the effective names are ASCII in both headers.
+        let ascii = encoding_flags(native(), b"spare", local, central);
+        assert!(crate::load_bytes(&ascii).is_ok(), "ASCII-compatible flag difference");
+    }
+}
