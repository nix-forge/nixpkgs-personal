+#[test]
+fn library_publication_rejects_conflicting_archive_headers() {
+    let dir = TempDir::new("archive-identity");
+    let c = config(dir.path());
+    let mut store = Store::open(dir.path(), c.store()).unwrap();
+    let (keyed, ..) = store.publish("Library", &snapshot("Library")).unwrap();
+    let valid = archive(0, 0);
+    let local = {
+        let mut zip = zip::ZipArchive::new(Cursor::new(&valid)).unwrap();
+        let start = zip.by_name("library/document.json").unwrap().header_start();
+        start as usize
+    };
+    let mut bad = valid.clone();
+    bad[local + 30] ^= 1;
+    assert!(store.publish_library(&keyed.id, &bad).is_err(), "do not retain or redistribute an ambiguous archive");
+    assert_eq!(store.publish_library(&keyed.id, &valid).unwrap(), 1, "a valid library remains publishable");
