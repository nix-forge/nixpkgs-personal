+//! Original synthetic archives exercising every public consuming boundary.
+use std::io::{Cursor, Read, Write};
+
+use figcraft_doc::Document;
+
+fn png() -> Vec<u8> {
+    let image = image::RgbaImage::from_pixel(1, 1, image::Rgba([10, 20, 30, 255]));
+    let mut bytes = Cursor::new(Vec::new());
+    image.write_to(&mut bytes, image::ImageFormat::Png).expect("synthetic PNG");
+    bytes.into_inner()
+}
+
+fn native() -> Vec<u8> {
+    crate::save_bytes(&Document::new("Archive fixture"), Some(&png())).expect("native fixture")
+}
+
+fn fig() -> Vec<u8> {
+    crate::fig::export(&Document::new("Archive fixture"), Some(&png())).expect("FIG fixture").0
+}
+
+fn header(bytes: &[u8], name: &str) -> usize {
+    zip::ZipArchive::new(Cursor::new(bytes)).expect("fixture archive").by_name(name).expect("fixture part").header_start() as usize
+}
+
+fn unicode_path(name: &str, crc: u32) -> Vec<u8> {
+    let mut field = 0x7075_u16.to_le_bytes().to_vec();
+    field.extend_from_slice(&((name.len() + 5) as u16).to_le_bytes());
+    field.push(1);
+    field.extend_from_slice(&crc.to_le_bytes());
+    field.extend_from_slice(name.as_bytes());
+    field
+}
+
+/// Append an empty stored member with independently specified original names and Unicode fields.
+#[allow(clippy::too_many_arguments)]
+fn append(mut bytes: Vec<u8>, local: &[u8], central: &[u8], local_extra: &[u8], central_extra: &[u8], descriptor: bool, utf8: bool) -> Vec<u8> {
+    let end = bytes.len() - 22;
+    assert_eq!(&bytes[end..end + 4], b"PK\x05\x06");
+    let count = u16::from_le_bytes(bytes[end + 10..end + 12].try_into().expect("count"));
+    let size = u32::from_le_bytes(bytes[end + 12..end + 16].try_into().expect("directory size"));
+    let start = u32::from_le_bytes(bytes[end + 16..end + 20].try_into().expect("directory start"));
+    let flags = if descriptor { 8_u16 } else { 0 } | if utf8 { 0x800 } else { 0 };
+    let mut entry = b"PK\x03\x04".to_vec();
+    for word in [20_u16, flags, 0, 0, 0] {
+        entry.extend_from_slice(&word.to_le_bytes());
+    }
+    entry.extend_from_slice(&[0; 12]);
+    entry.extend_from_slice(&(local.len() as u16).to_le_bytes());
+    entry.extend_from_slice(&(local_extra.len() as u16).to_le_bytes());
+    entry.extend_from_slice(local);
+    entry.extend_from_slice(local_extra);
+    if descriptor {
+        entry.extend_from_slice(b"PK\x07\x08");
+        entry.extend_from_slice(&[0; 12]);
+    }
+    let mut directory = b"PK\x01\x02".to_vec();
+    for word in [20_u16, 20, flags, 0, 0, 0] {
+        directory.extend_from_slice(&word.to_le_bytes());
+    }
+    directory.extend_from_slice(&[0; 12]);
+    for word in [central.len() as u16, central_extra.len() as u16, 0, 0, 0] {
+        directory.extend_from_slice(&word.to_le_bytes());
+    }
+    directory.extend_from_slice(&0_u32.to_le_bytes());
+    directory.extend_from_slice(&start.to_le_bytes());
+    directory.extend_from_slice(central);
+    directory.extend_from_slice(central_extra);
+    let mut eocd = bytes.split_off(end);
+    let old_directory = bytes.split_off(start as usize);
+    bytes.extend_from_slice(&entry);
+    bytes.extend_from_slice(&old_directory);
+    bytes.extend_from_slice(&directory);
+    for offset in [8, 10] {
+        eocd[offset..offset + 2].copy_from_slice(&(count + 1).to_le_bytes());
+    }
+    eocd[12..16].copy_from_slice(&(size + directory.len() as u32).to_le_bytes());
+    eocd[16..20].copy_from_slice(&(start + entry.len() as u32).to_le_bytes());
+    bytes.extend_from_slice(&eocd);
+    bytes
+}
+
+fn unlisted(mut bytes: Vec<u8>) -> Vec<u8> {
+    let end = bytes.len() - 22;
+    let start = u32::from_le_bytes(bytes[end + 16..end + 20].try_into().expect("directory start"));
+    let name = b"orphan";
+    let mut local = b"PK\x03\x04".to_vec();
+    local.extend_from_slice(&20_u16.to_le_bytes());
+    local.extend_from_slice(&[0; 20]);
+    local.extend_from_slice(&(name.len() as u16).to_le_bytes());
+    local.extend_from_slice(&[0; 2]);
+    local.extend_from_slice(name);
+    let mut eocd = bytes.split_off(end);
+    let directory = bytes.split_off(start as usize);
+    bytes.extend_from_slice(&local);
+    bytes.extend_from_slice(&directory);
+    eocd[16..20].copy_from_slice(&(start + local.len() as u32).to_le_bytes());
+    bytes.extend_from_slice(&eocd);
+    bytes
+}
+
+fn zip64(bytes: &[u8]) -> Vec<u8> {
+    let mut input = zip::ZipArchive::new(Cursor::new(bytes)).expect("fixture archive");
+    let mut writer = zip::ZipWriter::new(Cursor::new(Vec::new()));
+    for i in 0..input.len() {
+        let mut file = input.by_index(i).expect("fixture part");
+        let name = std::str::from_utf8(file.name_raw()).expect("ASCII fixture name").to_owned();
+        let options = zip::write::SimpleFileOptions::default().compression_method(file.compression()).large_file(true);
+        writer.start_file(name, options).expect("fixture writer");
+        let mut data = Vec::new();
+        file.read_to_end(&mut data).expect("fixture contents");
+        writer.write_all(&data).expect("fixture output");
+    }
+    writer.finish().expect("fixture finish").into_inner()
+}
+
+fn verify(bytes: &[u8], part: &str, accepts: impl Fn(&[u8]) -> bool) {
+    assert!(accepts(bytes), "ordinary control");
+    for (label, offset) in [("local filename", 30), ("local compression", 8), ("local CRC", 14)] {
+        let mut bad = bytes.to_vec();
+        bad[header(bytes, part) + offset] ^= 1;
+        assert!(!accepts(&bad), "{label}");
+    }
+    for name in ["unused", "文"] {
+        let field = unicode_path(name, 0x4ddb0c25);
+        let bad = append(bytes.to_vec(), b"plumless", b"buckeroo", &field, &field, false, false);
+        assert!(!accepts(&bad), "ignored UnicodePath CRC collision");
+    }
+    let unicode = unicode_path("café.txt", 0xa0976e8f);
+    for (local, central) in [(&unicode[..], &[][..]), (&[][..], &unicode[..])] {
+        let bad = append(bytes.to_vec(), b"caf\x82.txt", b"caf\x82.txt", local, central, false, false);
+        assert!(!accepts(&bad), "one-sided UnicodePath metadata");
+    }
+    let first = append(bytes.to_vec(), b"spare", b"spare", &[], &[], false, false);
+    assert!(!accepts(&append(first, b"spare", b"spare", &[], &[], false, false)), "duplicate raw names");
+    let cp437 = append(bytes.to_vec(), b"caf\x82.txt", b"caf\x82.txt", &[], &[], false, false);
+    let duplicate = append(cp437, "café.txt".as_bytes(), "café.txt".as_bytes(), &[], &[], false, true);
+    assert!(!accepts(&duplicate), "duplicate decoded names");
+    assert!(!accepts(&unlisted(bytes.to_vec())), "unlisted ignored local header");
+
+    assert!(accepts(&append(bytes.to_vec(), b"caf\x82.txt", b"caf\x82.txt", &unicode, &unicode, false, false)), "valid CP437 UnicodePath");
+    assert!(accepts(&append(bytes.to_vec(), b"\xc3\xa9", b"\xc3\xa9", &[], &[], false, false)), "unflagged CP437");
+    assert!(accepts(&append(bytes.to_vec(), "é".as_bytes(), "é".as_bytes(), &[], &[], false, true)), "flagged UTF-8");
+    assert!(accepts(&append(bytes.to_vec(), b"notes", b"notes", &[], &[], true, false)), "streaming descriptor");
+    assert!(accepts(&append(bytes.to_vec(), b"extras/", b"extras/", &[], &[], false, false)), "directory");
+    assert!(accepts(&zip64(bytes)), "ZIP64 parts");
+}
+
+#[test]
+fn zip_archive_native() {
+    verify(&native(), "document.json", |bytes| crate::load_bytes(bytes).is_ok());
+}
+
+#[test]
+fn zip_archive_fig() {
+    verify(&fig(), "canvas.fig", |bytes| crate::fig::import(bytes, "Synthetic.fig").is_ok());
+}
+
+#[test]
+fn zip_archive_library() {
+    verify(&native(), "document.json", |bytes| crate::read_library(Cursor::new(bytes)).is_ok());
+}
+
+#[test]
+fn zip_archive_library_within() {
+    verify(&native(), "document.json", |bytes| crate::read_library_within(Cursor::new(bytes), 1 << 20).is_ok());
+}
+
+#[test]
+fn zip_archive_thumbnail() {
+    verify(&native(), "document.json", |bytes| crate::thumbnail::thumbnail_png(Cursor::new(bytes)).is_some());
+}
+
+#[test]
+fn zip_archive_preview() {
+    verify(&native(), "document.json", |bytes| crate::thumbnail::archive_preview(Cursor::new(bytes), 8).picture.is_some());
+}
+
+#[test]
+fn zip_archive_recognized_fig_keeps_error_classification() {
+    let mut bytes = fig();
+    let offset = header(&bytes, "canvas.fig") + 30;
+    bytes[offset] ^= 1;
+    assert!(crate::fig::is_fig(&bytes), "metadata still recognizes the FIG container");
+    let Some(Err(crate::FormatError::Corrupt(error))) = crate::fig::try_import(&bytes, "Synthetic.fig") else {
+        panic!("recognized malformed FIG");
+    };
+    assert!(error.starts_with(".fig file: "), "preserve FIG error context: {error}");
+}
+
+fn encoding_flags(bytes: Vec<u8>, name: &[u8], local_utf8: bool, central_utf8: bool) -> Vec<u8> {
+    let mut bytes = append(bytes, name, name, &[], &[], false, false);
+    let (local, central) = {
+        let mut archive = zip::ZipArchive::new(Cursor::new(&bytes)).expect("fixture archive");
+        let index = archive.len() - 1;
+        let entry = archive.by_index(index).expect("last fixture entry");
+        (entry.header_start() as usize, entry.central_header_start() as usize)
+    };
+    if local_utf8 {
+        bytes[local + 7] |= 8;
+    }
+    if central_utf8 {
