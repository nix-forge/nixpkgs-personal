+#[cfg(all(test, target_os = "linux"))]
+mod native_wayland_clipboard_tests {
+    use super::*;
+    use std::io::Write;
+
+    // The isolated compositor runner must publish this asymmetric 2×2 RGBA PNG
+    // from a live external owner before starting the test.
+    const PIXELS: &[u8] = &[
+        255, 0, 0, 255, 0, 255, 0, 255, 0, 0, 255, 255, 255, 255, 0, 255,
+    ];
+
+    const EXPORT_PIXELS: &[u8] = &[
+        0, 255, 255, 255, 255, 0, 255, 255, 255, 255, 255, 255, 0, 0, 0, 255,
+    ];
+
+    #[test]
+    #[ignore = "requires an isolated data-control compositor, external PNG owner and wl-paste"]
+    fn native_wayland_image_clipboard_creates_pdf_and_exports_png()
+    -> Result<(), Box<dyn std::error::Error>> {
+        assert!(
+            std::env::var_os("DISPLAY").is_none(),
+            "X11 must not mask a missing native clipboard backend"
+        );
+        assert!(
+            std::env::var_os("WAYLAND_DISPLAY").is_some(),
+            "an isolated Wayland compositor is required"
+        );
+        let clip =
+            read_clipboard().ok_or("the external Wayland clipboard image was unavailable")?;
+        match clip {
+            Clip::Image {
+                width,
+                height,
+                rgba,
+            } => {
+                assert_eq!((width, height), (2, 2));
+                assert_eq!(rgba, PIXELS);
+            }
+            Clip::Text(_) => return Err("expected PNG data, received text".into()),
+        }
+        // Exercise the actual Create -> Clipboard command path, not only an injected Clip.
+        let mut app = PdfCraftApp::new();
+        app.create_from_clipboard();
+        let documents = app.session.docs();
+        assert_eq!(documents.len(), 1);
+        let document = documents
+            .first()
+            .ok_or("Create -> Clipboard did not produce a PDF")?;
+        assert_eq!(document.name, "Clipboard.pdf");
+        assert_eq!(document.info.pages.len(), 1);
+
+        // Image-region copy uses this same arboard set_image path. An external
+        // Wayland consumer checks MIME encoding and actual channel order.
+        let mut clipboard = arboard::Clipboard::new()?;
+        clipboard.set_image(arboard::ImageData {
+            width: 2,
+            height: 2,
+            bytes: std::borrow::Cow::Borrowed(EXPORT_PIXELS),
+        })?;
+        // Copy preparation starts a background protocol owner. The runner must
+        // observe its compositor-confirmed image selection before allowing the
+        // external read. Distinct pixels also reject the original PNG owner.
+        writeln!(std::io::stdout(), "ARTCRAFT_PDF_EXPORT_WAITING")?;
+        std::io::stdout().flush()?;
+        let mut acknowledgement = String::new();
+        std::io::stdin().read_line(&mut acknowledgement)?;
+        assert_eq!(acknowledgement, "export-ready\n");
+        let output = std::process::Command::new("wl-paste")
+            .args(["--type", "image/png", "--no-newline"])
+            .output()?;
+        assert!(output.status.success(), "external Wayland PNG read failed");
+        let image = image::load_from_memory(&output.stdout)?.to_rgba8();
+        assert_eq!(image.dimensions(), (2, 2));
+        assert_eq!(image.as_raw(), EXPORT_PIXELS);
+        Ok(())
+    }
+}
