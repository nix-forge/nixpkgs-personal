 skrifa = "0.44"
 
+[target.'cfg(target_os = "linux")'.dependencies]
+# Native image clipboard on compositors implementing ext/wlr data-control.
+arboard = { version = "3.6", default-features = false, features = ["wayland-data-control"] }
+
 [target.'cfg(target_os = "macos")'.dependencies]
 # Where the pointer is while files are dragged over the window (winit doesn't say): safe AppKit
 # calls only. All three are already in the tree through arboard and rfd.
