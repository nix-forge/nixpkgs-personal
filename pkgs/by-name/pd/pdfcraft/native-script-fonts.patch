+/// Both Chinese variants use the permitted Han face before Japanese fallbacks.
+fn embedded_font_definitions(cjk: CjkPreference) -> FontDefinitions {
+    font_definitions_for(matches!(cjk, CjkPreference::SimplifiedChinese | CjkPreference::TraditionalChinese))
+}
+
+#[cfg(test)]
+mod native_script_tests {
+    use super::*;
+
+    #[test]
+    fn chinese_faces_and_thai_glyphs_reach_all_interface_stacks() {
+        if pdfcraft_fonts::CRAFT_FONTS.is_empty() { return; }
+        for (language, expected) in [("zh-hans", true), ("zh-hant", true), ("ja", false), ("en", false)] {
+            let definitions = embedded_font_definitions(CjkPreference::for_language(language));
+            for family in [FontFamily::Proportional, FontFamily::Monospace, FontFamily::Name("medium".into()), FontFamily::Name("semibold".into())] {
+                let stack = &definitions.families[&family];
+                let droid = stack.iter().position(|name| name == "Droid Sans Fallback Regular");
+                let japanese = stack.iter().position(|name| name == "BIZ UDPGothic Regular");
+                assert!(droid.is_some() && japanese.is_some(), "both permitted fallback faces exist");
+                assert_eq!(droid < japanese, expected, "{language}: {family:?}");
+                assert!(stack.iter().any(|name| name == "Noto Sans Thai Regular"));
+            }
+            let mut fonts = egui::epaint::text::Fonts::new(egui::epaint::text::TextOptions::default(), definitions);
+            for id in [regular(13.0), egui::FontId::monospace(13.0), medium(13.0), semibold(17.0)] {
+                assert!(fonts.has_glyphs(&id, "เปิดไฟล์ บันทึก"), "{language}: {id:?}");
+                assert!(fonts.has_glyphs(&id, "打开文件 開啟檔案"), "{language}: {id:?}");
+            }
+        }
+    }
+}
