+    /// A monochrome face covering `c` whose backing file fits `max_bytes`.
+    /// Unlike document fallback, skip unsuitable faces and continue searching. Native
+    /// catalogue reads retain their existing 40 MiB ceiling. Newly borrowed faces are
+    /// returned without registering them in the document database or its miss cache.
+    pub fn bounded_plain_fallback_for(&self, c: char, max_bytes: usize) -> Option<Arc<FontFace>> {
+        let pick = || self.loaded_fallback_matching(c, u32::MAX, |f| !f.is_color() && f.data().len() <= max_bytes);
+        if let Some(f) = pick() {
+            return Some(f);
+        }
+        #[cfg(not(target_arch = "wasm32"))]
+        {
+            return self.bounded_plain_system_face_for(c, max_bytes.min(40 << 20));
+        }
+        #[cfg(target_arch = "wasm32")]
+        None
+    }
+
+    /// Borrow a bounded installed face without changing subsequent document fallback.
+    #[cfg(not(target_arch = "wasm32"))]
+    fn bounded_plain_system_face_for(&self, c: char, max_bytes: usize) -> Option<Arc<FontFace>> {
+        if c.is_control() || c.is_whitespace() || !self.sys.lock().unwrap_or_else(|e| e.into_inner()).enabled {
+            return None;
+        }
+        let mut paths: Vec<std::path::PathBuf> = self.read_catalog().iter().map(|e| e.path.clone()).collect();
+        paths.sort();
+        paths.dedup();
+        for p in paths {
+            if std::fs::metadata(&p).map(|m| m.len() > max_bytes as u64).unwrap_or(true) {
+                continue;
+            }
+            let Ok(data) = std::fs::read(&p) else { continue };
+            if data.len() > max_bytes {
+                continue;
+            }
+            let data = Arc::new(data);
+            for (index, family, style, coords) in enumerate_faces(&data) {
+                if has_color_tables(&data, index) {
+                    continue;
+                }
+                if let Some(face) = make_face(FontBytes::Owned(data.clone()), index, family, style, coords)
+                    && face.covers(c)
+                {
+                    return Some(Arc::new(face));
+                }
+            }
+        }
+        None
+    }
