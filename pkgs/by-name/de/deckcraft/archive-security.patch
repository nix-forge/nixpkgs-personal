+//! Synthetic ZIP boundary regressions; no third-party document fixtures.
+use std::io::Cursor;
+
+fn local_header(bytes: &[u8], name: &str) -> usize {
+    let mut archive = zip::ZipArchive::new(Cursor::new(bytes)).expect("archive");
+    archive.by_name(name).expect("part").header_start() as usize
+}
+
+fn valid() -> Vec<u8> {
+    deckcraft_format::save(&deckcraft_model::Presentation::default()).expect("save")
+}
+
+fn rejects_local_change(offset: usize) {
+    let mut bytes = valid();
+    let start = local_header(&bytes, "presentation.json");
+    // Keep the central directory and payload unchanged.
+    bytes[start + offset] ^= 1;
+    assert!(deckcraft_format::load(&bytes).is_err(), "local offset {offset}");
+}
+
+#[test]
+fn rejects_local_filename_mismatch() {
+    rejects_local_change(30);
+}
+
+#[test]
+fn rejects_local_compression_mismatch() {
+    rejects_local_change(8);
+}
+
+#[test]
+fn rejects_local_crc_mismatch() {
+    rejects_local_change(14);
+}
+
+#[test]
+fn oversized_symlink_declaration_is_an_error() {
+    let mut writer = zip::ZipWriter::new(Cursor::new(Vec::new()));
+    writer.add_symlink("presentation.json", "x", zip::write::SimpleFileOptions::default()).expect("symlink");
+    let mut bytes = writer.finish().expect("finish").into_inner();
+    let local = local_header(&bytes, "presentation.json");
+    let central = bytes.windows(4).position(|b| b == b"PK\x01\x02").expect("central directory");
+    // Declare nearly 4 GiB without allocating or decompressing it; retain a
+    // one-byte symlink target and matching local/central declared sizes.
+    bytes[local + 22..local + 26].copy_from_slice(&0xffff_fffe_u32.to_le_bytes());
+    bytes[central + 24..central + 28].copy_from_slice(&0xffff_fffe_u32.to_le_bytes());
+    assert!(deckcraft_format::load(&bytes).is_err());
+}
+
+#[test]
+fn valid_archive_roundtrip() {
+    assert!(deckcraft_format::load(&valid()).is_ok());
+}
+
+/// Append one original synthetic entry, retaining all normal presentation parts.
+fn extra_entry(mut bytes: Vec<u8>, local: &[u8], central: &[u8], unicode: Option<&str>, name_crc: u32, descriptor: bool) -> Vec<u8> {
+    let end = bytes.len() - 22;
+    assert_eq!(&bytes[end..end + 4], b"PK\x05\x06");
+    let count = u16::from_le_bytes(bytes[end + 10..end + 12].try_into().expect("count"));
+    let size = u32::from_le_bytes(bytes[end + 12..end + 16].try_into().expect("size"));
+    let start = u32::from_le_bytes(bytes[end + 16..end + 20].try_into().expect("offset"));
+    let mut extra = Vec::new();
+    if let Some(name) = unicode {
+        extra.extend_from_slice(&0x7075_u16.to_le_bytes());
+        extra.extend_from_slice(&((5 + name.len()) as u16).to_le_bytes());
+        extra.push(1);
+        extra.extend_from_slice(&name_crc.to_le_bytes());
+        extra.extend_from_slice(name.as_bytes());
+    }
+    let flags = if descriptor { 8_u16 } else { 0 };
+    let mut header = b"PK\x03\x04".to_vec();
+    for word in [20_u16, flags, 0, 0, 0] {
+        header.extend_from_slice(&word.to_le_bytes());
+    }
+    header.extend_from_slice(&[0; 12]); // CRC and empty compressed/uncompressed sizes.
+    header.extend_from_slice(&(local.len() as u16).to_le_bytes());
+    header.extend_from_slice(&(extra.len() as u16).to_le_bytes());
+    header.extend_from_slice(local);
+    header.extend_from_slice(&extra);
+    if descriptor {
+        header.extend_from_slice(b"PK\x07\x08");
+        header.extend_from_slice(&[0; 12]);
+    }
+    let mut directory = b"PK\x01\x02".to_vec();
+    for word in [20_u16, 20, flags, 0, 0, 0] {
+        directory.extend_from_slice(&word.to_le_bytes());
+    }
+    directory.extend_from_slice(&[0; 12]);
+    for word in [central.len() as u16, extra.len() as u16, 0, 0, 0] {
+        directory.extend_from_slice(&word.to_le_bytes());
+    }
+    directory.extend_from_slice(&0_u32.to_le_bytes());
+    directory.extend_from_slice(&start.to_le_bytes());
+    directory.extend_from_slice(central);
+    directory.extend_from_slice(&extra);
+    let mut eocd = bytes.split_off(end);
+    let old_directory = bytes.split_off(start as usize);
+    bytes.extend_from_slice(&header);
+    bytes.extend_from_slice(&old_directory);
+    bytes.extend_from_slice(&directory);
+    for offset in [8, 10] {
+        eocd[offset..offset + 2].copy_from_slice(&(count + 1).to_le_bytes());
+    }
+    eocd[12..16].copy_from_slice(&(size + directory.len() as u32).to_le_bytes());
+    eocd[16..20].copy_from_slice(&(start + header.len() as u32).to_le_bytes());
+    bytes.extend_from_slice(&eocd);
+    bytes
+}
