+#[test]
+fn rejects_unicode_path_crc_collision() {
+    // These different original ASCII names share CRC32 0x4ddb0c25.
+    let bytes = extra_entry(valid(), b"plumless", b"buckeroo", Some("unused"), 0x4ddb0c25, false);
+    assert!(deckcraft_format::load(&bytes).is_err());
+}
+
+#[test]
+fn rejects_non_ascii_unicode_path_crc_collision() {
+    // These different original ASCII names share CRC32 0x4ddb0c25.
+    let bytes = extra_entry(valid(), b"plumless", b"buckeroo", Some("文"), 0x4ddb0c25, false);
+    assert!(deckcraft_format::load(&bytes).is_err());
+}
+
+#[test]
+fn preserves_cp437_unicode_path() {
+    let bytes = extra_entry(valid(), b"caf\x82.txt", b"caf\x82.txt", Some("café.txt"), 0xa0976e8f, false);
+    assert!(deckcraft_format::load(&bytes).is_ok());
+}
+
+#[test]
+fn preserves_streaming_data_descriptor() {
+    let bytes = extra_entry(valid(), b"notes.txt", b"notes.txt", None, 0, true);
+    assert!(deckcraft_format::load(&bytes).is_ok());
+}
