+/// Translate inline Symbol private-use text without changing ordinary Unicode or other fonts.
+fn inline_symbol_char(face: &FontFace, font: Option<&str>, c: char) -> char {
+    if font.is_some_and(|f| f.eq_ignore_ascii_case("Symbol")) && ('\u{F000}'..='\u{F0FF}').contains(&c) {
+        symbol_char(face, "Symbol", c).unwrap_or(c)
+    } else {
+        c
+    }
+}
+
+fn canonical_symbol_char(c: char) -> char {
+    if ('\u{F000}'..='\u{F0FF}').contains(&c) { symbol_encoding::unicode((c as u32 & 0xFF) as u8).first().copied().unwrap_or('•') } else { c }
 }
 
