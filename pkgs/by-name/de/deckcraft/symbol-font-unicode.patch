+#[test]
+fn unicode_symbol_bullets_keep_their_character() {
+    assert_eq!(map_symbol_bullet("⇒", Some("Symbol")), "⇒");
+    assert_eq!(map_symbol_bullet("α", Some("Symbol")), "α");
+    let (p, mut sh) = setup("One", 600.0, 300.0);
+    let para = &mut sh.text.as_mut().unwrap().paragraphs[0];
+    para.props.bullet = Some(Bullet::Char { char: "α".into() });
+    para.props.bullet_font = Some("Symbol".into());
+    let layout = lay(&p, &sh, 600.0, 300.0);
+    let bullets: Vec<_> = layout.runs.iter().filter(|r| r.cells.is_empty()).collect();
+    assert_eq!(bullets.len(), 1);
+    let bullet = bullets[0];
+    let expected = bullet.face.glyph_for('α');
+    assert_ne!(expected, 0, "the chosen face must cover the Unicode bullet");
+    assert_eq!(bullet.glyphs.len(), 1);
+    assert_eq!(bullet.glyphs[0].0, expected);
+}
