     #[test]
+    fn glyph_detection_accepts_the_replacement_face_without_accepting_missing_glyphs() {
+        let mut definitions = FontDefinitions::empty();
+        definitions.font_data.insert("approved".into(), std::sync::Arc::new(FontData::from_static(deckcraft_fonts::last_resort_bytes())));
+        definitions.families.insert(FontFamily::Proportional, vec!["approved".into()]);
+        let mut fonts = egui::epaint::text::Fonts::new(egui::epaint::text::TextOptions::default(), definitions);
+        let mut view = fonts.with_pixels_per_point(1.0);
+        let id = egui::FontId::proportional(13.0);
+        for _ in 0..2 {
+            for c in ['A', '?', '◻'] {
+                let present = view.fonts.font(&id.family).characters().contains_key(&c);
+                assert_eq!(view.has_glyph(&id, c), present, "glyph detection must use coverage for {c:?}");
+            }
+            assert!(view.has_glyphs(&id, "A?"));
+            assert!(!view.has_glyph(&id, '\u{10FFFF}'));
+            assert!(!view.has_glyphs(&id, "A\u{10FFFF}"));
+        }
+        let mut empty = egui::epaint::text::Fonts::new(egui::epaint::text::TextOptions::default(), FontDefinitions::empty());
+        assert!(!empty.with_pixels_per_point(1.0).has_glyph(&id, 'A'));
+    }
