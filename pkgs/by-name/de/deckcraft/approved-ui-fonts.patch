+#[cfg(test)]
+mod font_policy_tests {
+    use super::*;
+
+    #[test]
+    fn approved_faces_render_without_vendor_emoji() {
+        let definitions = font_definitions(&[]);
+        assert!(definitions.font_data.keys().all(|name| !name.contains("NotoEmoji") && !name.contains("emoji-icon-font")));
+        for family in [FontFamily::Proportional, FontFamily::Monospace, FontFamily::Name("bold".into())] {
+            let stack = &definitions.families[&family];
+            assert!(!stack.is_empty());
+            assert!(stack.iter().all(|name| definitions.font_data.contains_key(name)));
+        }
+        assert_eq!(definitions.families[&FontFamily::Monospace].first().map(String::as_str), Some("deckcraft-hack-regular"));
+        let mut fonts = egui::epaint::text::Fonts::new(egui::epaint::text::TextOptions::default(), definitions);
+        let mut view = fonts.with_pixels_per_point(1.0);
+        for id in [font(13.0), bold(18.0), egui::FontId::monospace(13.0)] {
+            // epaint 0.36.2 has_glyphs compares the owning face with the replacement
+            // face, rejecting valid glyphs from that same face. Inspect the charmap.
+            let mut family = view.fonts.font(&id.family);
+            let characters = family.characters();
+            assert!("Open presentation 0123456789".chars().all(|glyph| characters.contains_key(&glyph)));
+        }
+        let id = egui::FontId::monospace(13.0);
+        let advance = view.glyph_width(&id, 'i');
+        assert!(advance.is_finite() && advance > 0.0);
+        for glyph in ['W', 'm', '0', ' '] {
+            assert!((view.glyph_width(&id, glyph) - advance).abs() <= f32::EPSILON, "monospaced advance differs for {glyph}");
+        }
+    }
+}
