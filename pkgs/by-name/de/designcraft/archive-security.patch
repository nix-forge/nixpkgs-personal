+//! Original synthetic ZIP mutations shared by archive-consumer regressions.
+use std::io::{Cursor, Read, Write};
+
+fn header(bytes: &[u8], name: &str) -> usize {
+    let mut archive = zip::ZipArchive::new(Cursor::new(bytes)).expect("fixture archive");
+    archive.by_name(name).expect("fixture part").header_start() as usize
+}
+
+fn upath(name: &str, crc: u32) -> Vec<u8> {
+    let mut data = 0x7075_u16.to_le_bytes().to_vec();
+    data.extend_from_slice(&((5 + name.len()) as u16).to_le_bytes());
+    data.push(1);
+    data.extend_from_slice(&crc.to_le_bytes());
+    data.extend_from_slice(name.as_bytes());
+    data
+}
+
+fn extra_entry(mut bytes: Vec<u8>, local: &[u8], central: &[u8], local_extra: &[u8], central_extra: &[u8], descriptor: bool) -> Vec<u8> {
+    let end = bytes.len() - 22;
+    assert_eq!(&bytes[end..end + 4], b"PK\x05\x06");
+    let count = u16::from_le_bytes(bytes[end + 10..end + 12].try_into().expect("count"));
+    let size = u32::from_le_bytes(bytes[end + 12..end + 16].try_into().expect("size"));
+    let start = u32::from_le_bytes(bytes[end + 16..end + 20].try_into().expect("offset"));
+    let flags = if descriptor { 8_u16 } else { 0 };
+    let mut local_header = b"PK\x03\x04".to_vec();
+    for word in [20_u16, flags, 0, 0, 0] {
+        local_header.extend_from_slice(&word.to_le_bytes());
+    }
+    local_header.extend_from_slice(&[0; 12]);
+    local_header.extend_from_slice(&(local.len() as u16).to_le_bytes());
+    local_header.extend_from_slice(&(local_extra.len() as u16).to_le_bytes());
+    local_header.extend_from_slice(local);
+    local_header.extend_from_slice(local_extra);
+    if descriptor {
+        local_header.extend_from_slice(b"PK\x07\x08");
+        local_header.extend_from_slice(&[0; 12]);
+    }
+    let mut directory = b"PK\x01\x02".to_vec();
+    for word in [20_u16, 20, flags, 0, 0, 0] {
+        directory.extend_from_slice(&word.to_le_bytes());
+    }
+    directory.extend_from_slice(&[0; 12]);
+    for word in [central.len() as u16, central_extra.len() as u16, 0, 0, 0] {
+        directory.extend_from_slice(&word.to_le_bytes());
+    }
+    directory.extend_from_slice(&0_u32.to_le_bytes());
+    directory.extend_from_slice(&start.to_le_bytes());
+    directory.extend_from_slice(central);
+    directory.extend_from_slice(central_extra);
+    let mut eocd = bytes.split_off(end);
+    let old_directory = bytes.split_off(start as usize);
+    bytes.extend_from_slice(&local_header);
+    bytes.extend_from_slice(&old_directory);
+    bytes.extend_from_slice(&directory);
+    for offset in [8, 10] {
+        eocd[offset..offset + 2].copy_from_slice(&(count + 1).to_le_bytes());
+    }
+    eocd[12..16].copy_from_slice(&(size + directory.len() as u32).to_le_bytes());
+    eocd[16..20].copy_from_slice(&(start + local_header.len() as u32).to_le_bytes());
+    bytes.extend_from_slice(&eocd);
+    bytes
+}
+
+fn zip64(bytes: &[u8]) -> Vec<u8> {
+    let mut input = zip::ZipArchive::new(Cursor::new(bytes)).expect("fixture archive");
+    let mut output = zip::ZipWriter::new(Cursor::new(Vec::new()));
+    for i in 0..input.len() {
+        let mut file = input.by_index(i).expect("fixture part");
+        // Exported fixtures have ASCII names; this API works on both dependency versions.
+        let name = std::str::from_utf8(file.name_raw()).expect("fixture name").to_owned();
+        let options = zip::write::SimpleFileOptions::default().compression_method(file.compression()).large_file(true);
+        output.start_file(name, options).expect("fixture writer");
+        let mut data = Vec::new();
+        file.read_to_end(&mut data).expect("fixture bytes");
+        output.write_all(&data).expect("fixture output");
+    }
+    output.finish().expect("fixture finish").into_inner()
+}
+
+/// Exercise the actual consumer, including unused members and valid legacy representations.
+pub fn verify(bytes: &[u8], part: &str, accepts: impl Fn(&[u8]) -> bool) {
+    assert!(accepts(bytes), "ordinary control");
+    let start = header(bytes, part);
+    for (label, offset) in [("local filename", 30), ("local compression", 8), ("local CRC", 14)] {
+        let mut malformed = bytes.to_vec();
+        malformed[start + offset] ^= 1;
+        assert!(!accepts(&malformed), "{label}");
+    }
+
+    // CRC-valid UnicodePath overrides must not hide conflicting original names.
+    for name in ["unused", "文"] {
+        let replacement = upath(name, 0x4ddb0c25);
+        let collision = extra_entry(bytes.to_vec(), b"plumless", b"buckeroo", &replacement, &replacement, false);
+        assert!(!accepts(&collision), "unused UnicodePath CRC collision: {name}");
+    }
+    let cp437 = extra_entry(bytes.to_vec(), b"caf\x82.txt", b"caf\x82.txt", &[], &[], false);
+    let duplicate = utf8_last(extra_entry(cp437, "café.txt".as_bytes(), "café.txt".as_bytes(), &[], &[], false));
+    assert!(!accepts(&duplicate), "duplicate decoded unused member");
+
+    let unicode = upath("café.txt", 0xa0976e8f);
+    for (local, central) in [(&unicode[..], &[][..]), (&[][..], &unicode[..])] {
+        let mismatch = extra_entry(bytes.to_vec(), b"caf\x82.txt", b"caf\x82.txt", local, central, false);
+        assert!(!accepts(&mismatch), "one-sided UnicodePath field");
+    }
+    let first = extra_entry(bytes.to_vec(), b"spare", b"spare", &[], &[], false);
+    let duplicate = extra_entry(first, b"spare", b"spare", &[], &[], false);
+    assert!(!accepts(&duplicate), "duplicate unused member");
+
+    let legacy = extra_entry(bytes.to_vec(), b"caf\x82.txt", b"caf\x82.txt", &unicode, &unicode, false);
+    assert!(accepts(&legacy), "valid CP437 UnicodePath");
+    let streamed = extra_entry(bytes.to_vec(), b"notes.txt", b"notes.txt", &[], &[], true);
+    assert!(accepts(&streamed), "valid streaming descriptor");
+    let directory = extra_entry(bytes.to_vec(), b"extras/", b"extras/", &[], &[], false);
+    assert!(accepts(&directory), "valid directory");
+    assert!(accepts(&zip64(bytes)), "valid ZIP64 parts");
+}
+
+fn empty_zip() -> Vec<u8> {
+    zip::ZipWriter::new(Cursor::new(Vec::new())).finish().expect("empty archive").into_inner()
+}
+
+fn utf8_last(mut bytes: Vec<u8>) -> Vec<u8> {
+    let mut archive = zip::ZipArchive::new(Cursor::new(&bytes)).expect("fixture archive");
+    let file = archive.by_index(archive.len() - 1).expect("last fixture entry");
+    let local = file.header_start() as usize;
+    let central = file.central_header_start() as usize;
+    drop(file);
+    drop(archive);
+    for offset in [local + 6, central + 8] {
+        let flags = u16::from_le_bytes(bytes[offset..offset + 2].try_into().expect("flags")) | 0x800;
+        bytes[offset..offset + 2].copy_from_slice(&flags.to_le_bytes());
+    }
+    bytes
+}
+
+#[test]
+fn zip_encoding_unicode_crc_collision() {
+    let unicode = upath("文", 0x4ddb0c25);
+    let bytes = extra_entry(empty_zip(), b"plumless", b"buckeroo", &unicode, &unicode, false);
+    let mut archive = zip::ZipArchive::new(Cursor::new(bytes)).expect("fixture archive");
+    assert!(archive.validate_header_consistency().is_err(), "original header names conflict despite matching UnicodePath");
+}
+
+#[test]
+fn zip_encoding_duplicate_decoded_names() {
+    let cp437 = extra_entry(empty_zip(), b"caf\x82.txt", b"caf\x82.txt", &[], &[], false);
+    let bytes = utf8_last(extra_entry(cp437, "café.txt".as_bytes(), "café.txt".as_bytes(), &[], &[], false));
+    let mut archive = zip::ZipArchive::new(Cursor::new(bytes)).expect("fixture archive");
+    assert!(archive.validate_header_consistency().is_err(), "two encodings name the same member");
+}
+
+#[test]
+fn zip_encoding_preserves_unflagged_cp437() {
+    // C3 A9 happens to be UTF-8 too; bit 11, not byte validity, selects the encoding.
+    let bytes = extra_entry(empty_zip(), b"\xc3\xa9", b"\xc3\xa9", &[], &[], false);
+    let mut archive = zip::ZipArchive::new(Cursor::new(bytes)).expect("fixture archive");
+    archive.validate_header_consistency().expect("valid legacy archive");
+    assert_eq!(archive.by_index(0).expect("entry").name().expect("name"), "├⌐");
+    assert!(archive.by_name("├⌐").is_ok());
+    assert!(archive.by_name("é").is_err(), "raw UTF-8 lookup must not alias a CP437 name");
+    let bytes = utf8_last(extra_entry(empty_zip(), "é".as_bytes(), "é".as_bytes(), &[], &[], false));
+    let mut archive = zip::ZipArchive::new(Cursor::new(bytes)).expect("fixture archive");
+    archive.validate_header_consistency().expect("valid UTF-8 archive");
+    assert_eq!(archive.by_index(0).expect("entry").name().expect("name"), "é");
+}
